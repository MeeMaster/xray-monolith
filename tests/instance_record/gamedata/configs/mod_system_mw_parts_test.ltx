; Test data for mw_ir.fits() (WEAPON_ENGINE_PLAN.md 10.1, change 5a). Remove this file when you are done testing.
; Two plain inventory items used as parts: a light that holds batteries, and a battery that is data only
; (never drawn on the gun). Both look like bandages in the inventory and on the ground.

[mw_pt_light]:bandage

[mw_pt_battery]:bandage
part_visual = none

; 5b roles (mw_ir.roles()): a sight, a sight with a laser (its role list is untidy on purpose), a muzzle part
[mw_pt_sight]:bandage
role = sight

[mw_pt_sight_laser]:bandage
role = Sight, laser, sight

[mw_pt_muzzle]:bandage
role = muzzle

[mw_pt_launcher]:bandage
role = launcher

; 5b-2 sights (mw_ir.sights()): a 4x sight with its own scope keys, and one that takes its data from a vanilla scope
[mw_pt_sight_4x]:bandage
role = sight
scope_zoom_factor = 4
scope_texture = none

[mw_pt_sight_ref]:bandage
role = sight
sight_section = wpn_addon_scope

; 5b-3 muzzles (mw_ir.muzzles()): a silencer with a koef, and a brake that only adds a key through muzzle_keys
[mw_pt_muzzle_sil]:bandage
role = muzzle
silencer = true
bullet_hit_power_k = 0.9

[mw_pt_muzzle_brake]:bandage
role = muzzle
muzzle_keys = fire_dispersion_base
fire_dispersion_base = 0.33

; 5b-4 launchers (mw_ir.launchers())
[mw_pt_launcher_gl]:bandage
role = launcher
grenade_vel = 77
cam_dispersion_k = 0.8

; 5c aim (mw_ir.aim()): a sight that lowers the aim
[mw_pt_sight_aim]:bandage
role = sight
scope_texture = none
part_aim_delta_pos = 0, -0.02, 0

; 5d devices (mw_ir.devices()): a flashlight that needs power, a laser that does not, a battery of 7 seconds
[mw_pt_flashlight]:bandage
role = light
needs_power = true
light_range = 20
light_cone = 30
light_color = 1, 0.95, 0.85

[mw_pt_laser]:bandage
role = laser
laser_range = 50
laser_color = 1, 0, 0

[mw_pt_cell]:bandage
role = battery
part_visual = none
battery_capacity = 0.002
