-- Copy of Part_bench mw_ogf.script, used by mw_ir.placement() to check the engine's bind poses (4a) against it.
-- Modular weaponry: bone bind poses read straight from OGF files, so mount
-- points and aim points come from bones in the meshes instead of numbers typed
-- into the LTX. A part attached to another part can't be placed on that part's
-- bones by the engine (the bone name is looked up on the gun), and an attachment
-- can't be asked where its bones are in its own space, so the file is read.
--
-- bones(model) -> { [name] = { pos = {x, y, z}, rot = 3x3 } } in model space
-- (each bone composed with its parents), or nil when the file can't be read.
-- model is a path under meshes without .ogf, as in the LTX. Cached per model.
--
-- In our exports the vertices and the bones share the model space, and the
-- engine draws a rigid part with its vertices as stored, so a bone's model
-- position is where it shows on the part.

local cache = {}

local function log(fmt, ...)
	printf("[mw_ir_ogf] " .. fmt, ...)
end

local function u32(s, i)
	local a, b, c, d = string.byte(s, i, i + 3)
	return a + b * 256 + c * 65536 + d * 16777216
end

-- Little-endian IEEE 754 single.
local function f32(s, i)
	local a, b, c, d = string.byte(s, i, i + 3)
	local sign = d >= 128 and -1 or 1
	local exp = (d % 128) * 2 + math.floor(c / 128)
	local mant = (c % 128) * 65536 + b * 256 + a
	if exp == 0 or exp == 255 then
		return 0
	end
	return sign * (1 + mant / 8388608) * 2 ^ (exp - 127)
end

local function zstr(s, i)
	local e = string.find(s, "\0", i, true)
	return string.sub(s, i, e - 1), e + 1
end

-- 3x3 matrices as rows { {a,b,c}, {d,e,f}, {g,h,i} }.
local function mul(a, b)
	local m = {}
	for r = 1, 3 do
		m[r] = {}
		for c = 1, 3 do
			m[r][c] = a[r][1] * b[1][c] + a[r][2] * b[2][c] + a[r][3] * b[3][c]
		end
	end
	return m
end

function apply(m, v)
	return {
		m[1][1] * v[1] + m[1][2] * v[2] + m[1][3] * v[3],
		m[2][1] * v[1] + m[2][2] * v[2] + m[2][3] * v[3],
		m[3][1] * v[1] + m[3][2] * v[2] + m[3][3] * v[3],
	}
end

identity = { { 1, 0, 0 }, { 0, 1, 0 }, { 0, 0, 1 } }

-- A bone's bind rotation (radians, x y z as stored). The engine builds it with
-- setXYZi, i.e. setHPB(-y, -x, -z); in these matrices that is this product.
-- The order only matters for bones turned about more than one axis; about Y
-- alone it matches the dovetail mount, measured by hand (2026-10-26).
local function bind_matrix(x, y, z)
	local cx, sx = math.cos(x), math.sin(x)
	local cy, sy = math.cos(y), math.sin(y)
	local cz, sz = math.cos(z), math.sin(z)
	local rx = { { 1, 0, 0 }, { 0, cx, -sx }, { 0, sx, cx } }
	local ry = { { cy, 0, sy }, { 0, 1, 0 }, { -sy, 0, cy } }
	local rz = { { cz, -sz, 0 }, { sz, cz, 0 }, { 0, 0, 1 } }
	return mul(ry, mul(rx, rz))
end

-- An attachment rotation (degrees: heading about Y, pitch about X, bank about Z),
-- as set_rotation takes it: the engine's setHPB(h, p, b), which is setXYZi with
-- every angle negated. Without the negation a bone banked 45 degrees clockwise
-- came out anticlockwise (the canted Picatinny mount, 2026-10-29).
function hpb_matrix(h, p, b)
	return bind_matrix(-math.rad(p or 0), -math.rad(h or 0), -math.rad(b or 0))
end

function mat_mul(a, b)
	return mul(a, b)
end

-- Degrees heading, pitch, bank of a matrix built by hpb_matrix.
function matrix_hpb(m)
	local p = math.asin(math.max(-1, math.min(1, -m[2][3])))
	local h, b
	if math.abs(math.cos(p)) > 1e-6 then
		h = math.atan2(m[1][3], m[3][3])
		b = math.atan2(m[2][1], m[2][2])
	else
		h = math.atan2(-m[3][1], m[1][1])
		b = 0
	end
	return { -math.deg(h), -math.deg(p), -math.deg(b) }
end

local function read_file(model)
	local ok, path = pcall(function()
		local fs = getFS()
		if not fs:exist("$game_meshes$", model .. ".ogf") then
			return nil
		end
		return fs:update_path("$game_meshes$", model .. ".ogf")
	end)
	if not (ok and path) then
		return nil
	end
	local f = io.open(path, "rb")
	if not f then
		return nil
	end
	local s = f:read("*a")
	f:close()
	return s
end

local function parse(s)
	local names, parents, local_pose = {}, {}, {}
	local p = 1
	local bone_chunk, data_chunk
	while p + 7 <= #s do
		local id, size = u32(s, p), u32(s, p + 4)
		if id == 0xD then
			bone_chunk = p + 8
		elseif id == 0x10 then
			data_chunk = p + 8
		end
		p = p + 8 + size
	end
	if not (bone_chunk and data_chunk) then
		return nil
	end
	-- 0xD: count, then per bone: name, parent name, oriented box (60 bytes).
	local n = u32(s, bone_chunk)
	p = bone_chunk + 4
	for i = 1, n do
		names[i], p = zstr(s, p)
		parents[i], p = zstr(s, p)
		p = p + 60
	end
	-- 0x10, per bone: version, material, shape (112), joint (72, +4 friction
	-- from version 1), bind rotation, bind position, mass, centre of mass.
	p = data_chunk
	for i = 1, n do
		local ver = u32(s, p)
		local _, q = zstr(s, p + 4)
		q = q + 112 + 72 + (ver > 0 and 4 or 0)
		local_pose[i] = {
			rot = bind_matrix(f32(s, q), f32(s, q + 4), f32(s, q + 8)),
			pos = { f32(s, q + 12), f32(s, q + 16), f32(s, q + 20) },
		}
		p = q + 24 + 16
	end
	-- Compose each bone with its parents into model space.
	local index = {}
	for i = 1, n do
		index[names[i]] = i
	end
	local out = {}
	local function model_pose(i)
		local name = names[i]
		if out[name] then
			return out[name]
		end
		local lp = local_pose[i]
		local parent = parents[i] ~= "" and index[parents[i]]
		local pose
		if parent then
			local pp = model_pose(parent)
			local off = apply(pp.rot, lp.pos)
			pose = { pos = { pp.pos[1] + off[1], pp.pos[2] + off[2], pp.pos[3] + off[3] }, rot = mul(pp.rot, lp.rot) }
		else
			pose = { pos = lp.pos, rot = lp.rot }
		end
		out[name] = pose
		return pose
	end
	for i = 1, n do
		model_pose(i)
	end
	return out
end

function bones(model)
	if not model then
		return nil
	end
	if cache[model] == nil then
		local s = read_file(model)
		local ok, res = false, nil
		if s then
			ok, res = pcall(parse, s)
		end
		if ok and res then
			cache[model] = res
		else
			cache[model] = false
			log("! can't read the bones of meshes\\%s.ogf", model)
		end
	end
	return cache[model] or nil
end

-- The model of a gun's HUD section (item_visual), as a path without .ogf.
function hud_model(gun_section)
	local hud = ini_sys:r_string_ex(gun_section, "hud")
	local vis = hud and ini_sys:r_string_ex(hud, "item_visual")
	if not vis then
		return nil
	end
	vis = string.gsub(vis, "/", "\\")
	vis = string.gsub(vis, "%.ogf$", "")
	return vis
end
