-- Tests for phase 2 (WEAPON_ENGINE_PLAN.md 4 and 5): the instance record, its script API (2h)
-- and its survival across save/load, NPCs, going offline and level changes (2i).
-- Vanilla Anomaly + this engine build. Copy this file into gamedata\scripts (install.ps1 does it).
--
--   run_string mw_ir.api()          on the gun in your hands: checks every script function on
--                                   both the game object and the server object, then removes
--                                   what it added. Needs nothing else.
--   run_string mw_ir.prepare()      marks the gun in your hands: rpm = 120, a mark override, a state value and a
--                                   small part tree (a scope with a cover, two parts on one rail)
--   run_string mw_ir.verify()       finds the marked gun wherever it is (hands, backpack, an NPC,
--                                   online or offline) and checks its whole record
--   run_string mw_ir.npc_give()     gives the marked gun to the NPC under the crosshair
--   run_string mw_ir.offline_edit() while the marked gun is offline, sets an override through the
--                                   server object; verify() then expects it on the game side too
--   run_string mw_ir.snapshot("a")  writes every non-empty record in the game to
--                                   appdata\mw_ir_a.txt; snapshot("b") after a save/load, then
--   run_string mw_ir.compare("a", "b")  reports any record that changed
--   run_string mw_ir.cleanup()      clears the marked gun's overrides, parts and modifier
--
-- Stacked modifiers (3d, WEAPON_ENGINE_PLAN.md 6.3). Needs configs\misc\stat_mods.ltx and
-- configs\mod_system_mw_stat_mods_test.ltx from this folder (install.ps1 copies them).
--   run_string mw_ir.mods()           on the gun in your hands: script and part modifiers, the formula, list
--                                     keys, clamps, the pct floor, missing keys; removes what it added
--   run_string mw_ir.mods_spawn()     puts two wpn_ak74 into your backpack for mods_upgrades()
--   run_string mw_ir.mods_upgrades()  installs two test upgrades on them in opposite orders and checks
--                                     both give base rpm x 1.05; run it again after a save/load
--   run_string mw_ir.mods_outfit()    adds a modifier to your outfit's burn_protection; run it
--                                     again after a save/load to check it survived
-- prepare() also gives the marked gun a script modifier, rpm +25% over its rpm = 120 override, so
-- verify() expects rpm = 150 in the generated section.
--
-- Part placement and bind poses (4a, WEAPON_ENGINE_PLAN.md 8.1):
--   run_string mw_ir.placement()      on the gun in your hands: placement props (bone, offset, hides),
--                                     model_bones / bone_bind_transform, and the bind poses compared bone
--                                     by bone with Part_bench's OGF parser (mw_ir_ogf.script) on the AK test model
-- prepare() also places the marked gun's scope (PLACEMENT), and verify() checks the placement.
--
-- Engine-drawn parts (4b, WEAPON_ENGINE_PLAN.md 8.2):
--   run_string mw_ir.fits()           5a fit and remove with test items (a light holding batteries); runs in steps.
--   run_string mw_ir.offline()        5a fit and remove on offline server entities (made on another level).
--   run_string mw_ir.upgrade_keep()   5a a mechanic upgrade keeps the rounds and parts (a fresh AK in your inventory).
--   run_string mw_ir.roles()          5b-1 part roles, the active sight, and vanilla scope exclusivity.
--   run_string mw_ir.moves()          after parts(): 4d placement-only moves and place_parts hooks (moves_clear()).
--   run_string mw_ir.hooks()          after parts(): script hooks on the test parts (bone visibility by view,
--                                     part transforms, a light on part A). hooks_clear() detaches the light.
--   run_string mw_ir.parts()          on the gun in your hands: fits two visible test parts (copies of the gun's
--                                     own model, one turned 90 degrees on top, one nested on it), plus parts that
--                                     must not draw, and checks the part tree. The two stay for you to look at.
--   run_string mw_ir.parts_check()    the gun in your hands still has the two drawn parts (after save/load etc.)
--   run_string mw_ir.parts_clear()    removes the test parts from the gun in your hands
--
-- Every result goes to the log as "[mw_ir] PASS ..." or "[mw_ir] FAIL ...".

local MARK = "mw_ir_mark"
local OVR = { rpm = "120", [MARK] = "1" }
-- 3c: a state value; it must survive everything the config values do and never reach the generated section
local STATE_KEY, STATE_VALUE = "mw_ir_charge", "0.75"
-- 3d: a script modifier stacking on the rpm override: 120 x 1.25
local MOD = { source = "mw_ir:test", key = "rpm", value = 0.25, mode = "pct" }
local RPM_FINAL = 150
-- 4a: the scope part's placement, as the script resolver would write it, and its normal form
local PLACEMENT = { bone = "wpn_body", offset = "0.0, 0.05,0.1, 0, 0, 90", hides = "wpn_scope, wpn_scope" }
local PLACEMENT_OFFSET = "0, 0.05, 0.1, 0, 0, 90"

-- The part tree prepare() builds; paths are what get_parts() must report
local PARTS = {
	{ key = "scope", parent = nil, mount = "scope", section = "wpn_addon_scope", pos = 0 },
	{ key = "cover", parent = "scope", mount = "cover", section = "mw_ir_cover", pos = 0 },
	{ key = "light", parent = nil, mount = "top", section = "mw_ir_light", pos = 0.05 },
	{ key = "laser", parent = nil, mount = "top", section = "mw_ir_laser", pos = 0.12 },
}

local fails, passes = 0, 0

local function say(text)
	printf("[mw_ir] %s", text)
	if actor_menu and actor_menu.set_msg then
		actor_menu.set_msg(1, "mw_ir: " .. text, 6)
	end
end

local function check(ok, what)
	if ok then
		passes = passes + 1
		printf("[mw_ir] PASS %s", what)
	else
		fails = fails + 1
		printf("[mw_ir] FAIL %s", what)
	end
	return ok
end

local function begin()
	fails, passes = 0, 0
end

local function finish(name)
	say(string.format("%s: %d passed, %d failed", name, passes, fails))
end

local function gun()
	local w = db.actor and db.actor:active_item()
	if not (w and IsWeapon(w)) then
		say("take a gun in your hands first")
		return
	end
	return w
end

local function count(t)
	local n = 0
	for _ in pairs(t) do n = n + 1 end
	return n
end

local function near(a, b)
	return math.abs(a - b) < 0.001
end

-- Every inventory item in the server registry, online or not, with a record API
local function each_item(fn)
	local sim = alife()
	for id = 1, 65534 do
		local se = sim:object(id)
		if se then
			local ok, size = pcall(function() return se:record_size() end)
			if ok and size then
				fn(se, id, size)
			end
		end
	end
end

local function find_marked()
	local found
	each_item(function(se, id, size)
		if size > 1 and se:get_override(MARK) then
			found = found or se
		end
	end)
	return found
end

---------------------------------------------------------------------------
-- api(): 2h on the gun in hand, game object and server object side by side
---------------------------------------------------------------------------

function api()
	local w = gun()
	if not w then return end
	begin()
	local se = alife_object(w:id())
	check(se ~= nil, "server object exists")
	if not se then return finish("api") end

	local base = w:section()
	check(w:instance_section() ~= nil, "instance_section() returns a name: " .. tostring(w:instance_section()))
	check(not string.find(base, "_i%d+$"), "section() is the base: " .. base)

	-- Overrides: number, string and boolean values
	check(w:set_override("mw_ir_num", 42) == true, "set_override with a number")
	check(w:get_override("mw_ir_num") == "42", "number stored as \"42\": " .. tostring(w:get_override("mw_ir_num")))
	check(w:set_override("mw_ir_flt", 0.25) == true, "set_override with a fraction")
	check(w:get_override("mw_ir_flt") == "0.25", "fraction stored as \"0.25\": " .. tostring(w:get_override("mw_ir_flt")))
	check(w:set_override("mw_ir_str", "abc") == true, "set_override with a string")
	check(w:set_override("mw_ir_bool", true) == true, "set_override with a boolean")
	check(w:get_override("mw_ir_bool") == "true", "boolean stored as \"true\"")
	check(w:set_override("mw_ir_bad", {}) == false, "set_override with a table is refused")
	check(w:get_override("mw_ir_bad") == nil, "refused value not stored")
	check(w:get_override("mw_ir_missing") == nil, "missing key reads nil")

	-- The server copy follows each game-side edit (event, 4.3)
	check(se:get_override("mw_ir_str") == "abc", "server object sees the game-side edit")

	local all = w:get_overrides()
	check(all.mw_ir_num == "42" and all.mw_ir_str == "abc", "get_overrides() returns them")

	-- Clearing: by nil, by the one-argument form, and with clear_override
	check(w:set_override("mw_ir_num", nil) == true and w:get_override("mw_ir_num") == nil, "set_override(key, nil) clears")
	check(w:set_override("mw_ir_flt") == true and w:get_override("mw_ir_flt") == nil, "set_override(key) clears")
	check(w:clear_override("mw_ir_bool") == true and w:get_override("mw_ir_bool") == nil, "clear_override clears")
	check(w:clear_override("mw_ir_bool") == false, "clearing a missing key returns false")

	-- Server-side edit of an online item goes through the game object
	check(se:set_override("mw_ir_se", "x") == true, "server-side set_override on an online item")
	check(w:get_override("mw_ir_se") == "x", "game object sees the server-side edit")
	check(se:clear_override("mw_ir_se") == true and w:get_override("mw_ir_se") == nil, "server-side clear_override")

	-- Parts
	local size0 = w:record_size()
	local a = w:record_add_part(0, "mw_ir_mount", "mw_ir_part_a")
	check(a > 0, "record_add_part returns an id: " .. a)
	local b = w:record_add_part(a, "child", "mw_ir_part_b", 0.5)
	check(b > a, "child part gets a new id: " .. b)
	local r1 = w:record_add_part(0, "mw_ir_rail", "mw_ir_part_c", 0.1)
	local r2 = se:record_add_part(0, "mw_ir_rail", "mw_ir_part_d", 0.2)
	check(r1 > 0 and r2 > 0, "two parts on one mount, one added from the server object")
	check(w:record_add_part(999, "x", "mw_ir_part_e") == 0, "part with a missing parent is refused")
	check(w:record_size() > size0, "record_size grows: " .. size0 .. " -> " .. w:record_size())

	local parts = w:get_parts()
	local pb = parts["mw_ir_mount/child"]
	check(parts["mw_ir_mount"] and parts["mw_ir_mount"].id == a, "path of a top-level part")
	check(pb and pb.id == b and pb.parent == a and near(pb.pos, 0.5) and pb.section == "mw_ir_part_b", "path, parent, pos and section of a child part")
	check(pb and near(pb.condition, 1) and pb.paintjob == "" and #pb.upgrades == 0 and count(pb.props) == 0, "defaults of a new part")
	check(parts["mw_ir_rail#" .. r1] and parts["mw_ir_rail#" .. r2], "parts sharing a mount are named <mount>#<id>")
	check(count(se:get_parts()) == count(parts), "server object lists the same parts")

	check(w:record_remove_part(a) == 2, "removing a part removes its child too")
	check(se:record_remove_part(r1) == 1, "server-side record_remove_part")
	check(w:record_remove_part(r2) == 1, "remove the last test part")
	check(w:record_remove_part(r2) == 0, "removing a missing part returns 0")
	check(count(w:get_parts()) == 0 or not w:get_parts()["mw_ir_mount"], "test parts are gone")

	check(w:clear_override("mw_ir_str"), "clean up")

	-- 3c: state values (reload = false) next to config values
	local function in_section(key)
		local s = w:instance_section()
		return s ~= base and ini_sys:line_exist(s, key)
	end
	-- The clean-up above changed config; let its rebuild happen before counting
	w:instance_section()
	local c0 = w:record_counters()
	check(w:set_override("mw_ir_api_charge", 0.5, false) == true, "set_override(key, value, false) stores a state value")
	check(w:is_state_override("mw_ir_api_charge") and not se:is_state_override("mw_ir_missing"), "is_state_override")
	check(w:get_override("mw_ir_api_charge") == "0.5", "get_override reads a state value")
	check(not in_section("mw_ir_api_charge"), "a state value is not in the generated section")
	check(w:get_overrides("state").mw_ir_api_charge == "0.5" and w:get_overrides("config").mw_ir_api_charge == nil,
		"get_overrides filters by kind")
	check(w:get_overrides().mw_ir_api_charge == "0.5", "get_overrides() without a filter lists both kinds")

	local c1 = w:record_counters()
	for i = 1, 1000 do
		w:set_override("mw_ir_api_charge", i / 1000, false)
	end
	w:instance_section()
	local c2 = w:record_counters()
	check(c2.sends - c1.sends <= 1, "1000 state writes in a frame send at most one record: " .. (c2.sends - c1.sends))
	check(c2.builds == c1.builds, "and build no section: " .. (c2.builds - c1.builds))
	check(c1.builds == c0.builds, "setting the first state value built no section either")

	-- Moving a key between kinds adds it to and removes it from the section
	check(w:set_override("mw_ir_api_charge", "0.75") and not w:is_state_override("mw_ir_api_charge"), "set as config moves the key")
	check(in_section("mw_ir_api_charge"), "moved to config: now in the generated section")
	check(w:set_override("mw_ir_api_charge", "0.75", false) and w:is_state_override("mw_ir_api_charge"), "set as state moves it back")
	check(not in_section("mw_ir_api_charge"), "moved to state: gone from the section")

	-- Several config writes in a frame build the section once
	local c3 = w:record_counters()
	w:set_override("mw_ir_c1", "1")
	w:set_override("mw_ir_c2", "2")
	w:set_override("mw_ir_c3", "3")
	local inst = w:instance_section()
	w:instance_section()
	local c4 = w:record_counters()
	check(c4.builds - c3.builds == 1, "three config writes build the section once: " .. (c4.builds - c3.builds))
	check(c4.sends - c3.sends == 3, "and send each change at once: " .. (c4.sends - c3.sends))
	check(ini_sys:r_string_ex(inst, "mw_ir_c2") == "2", "the section has all three")

	-- Clearing: a state value builds nothing, a config value rebuilds the section
	local c5 = w:record_counters()
	check(w:clear_override("mw_ir_api_charge") and w:get_override("mw_ir_api_charge") == nil, "clear a state value")
	w:instance_section()
	check(w:record_counters().builds == c5.builds, "clearing a state value builds no section")
	for _, k in ipairs({ "mw_ir_c1", "mw_ir_c2", "mw_ir_c3" }) do w:clear_override(k) end
	w:instance_section()
	check(w:record_counters().builds == c5.builds + 1, "clearing config values rebuilds it once")

	-- The server copy catches up with a state value after the flush (save, going offline, or 0.5 s)
	check(se:set_override("mw_ir_se_state", "x", false) and w:is_state_override("mw_ir_se_state"),
		"server-side set_override(key, value, false) on an online item")
	check(se:clear_override("mw_ir_se_state"), "server-side clear of a state value")
	finish("api")
	say("api: a ReloadConfig of the gun follows in the log ([reload config]) once it is idle")
end

---------------------------------------------------------------------------
-- prepare() / verify(): the marked gun across save/load, NPCs, offline, level changes
---------------------------------------------------------------------------

function prepare()
	local w = gun()
	if not w then return end
	begin()
	-- Start clean so the part ids and paths are predictable
	for _, p in pairs(w:get_parts()) do
		if p.parent == 0 then w:record_remove_part(p.id) end
	end
	for k in pairs(w:get_overrides()) do w:clear_override(k) end
	w:remove_modifier(MOD.source)

	for k, v in pairs(OVR) do
		check(w:set_override(k, v), "set " .. k .. " = " .. v)
	end
	check(w:set_override(STATE_KEY, STATE_VALUE, false), "set state value " .. STATE_KEY .. " = " .. STATE_VALUE)
	check(w:add_modifier(MOD.source, MOD.key, MOD.value, MOD.mode), "add modifier " .. MOD.key .. " +25% from " .. MOD.source)
	local ids = {}
	for _, p in ipairs(PARTS) do
		local parent = p.parent and ids[p.parent] or 0
		ids[p.key] = w:record_add_part(parent, p.mount, p.section, p.pos)
		check(ids[p.key] > 0, "add " .. p.key)
	end
	for k, v in pairs(PLACEMENT) do
		check(w:set_part_prop(ids.scope, k, v), "place the scope: " .. k .. " = " .. v)
	end
	finish("prepare")
	say(string.format("marked %s [%d]. Its rpm override applies after a save/load. Run verify() any time.", w:section(), w:id()))
end

local function has_mod(mods, source, key, mode, value)
	for _, m in ipairs(mods) do
		if m.source == source and m.key == key and m.mode == mode and near(m.value, value) then
			return true
		end
	end
	return false
end

local function verify_record(get_override, get_parts, where, is_state, get_modifiers)
	check(has_mod(get_modifiers(), MOD.source, MOD.key, MOD.mode, MOD.value),
		where .. ": modifier " .. MOD.source .. " " .. MOD.key .. " " .. MOD.mode .. " " .. MOD.value)
	for k, v in pairs(OVR) do
		check(get_override(k) == v, where .. ": override " .. k .. " = " .. tostring(get_override(k)))
	end
	check(get_override(STATE_KEY) == STATE_VALUE and is_state(STATE_KEY) and not is_state(MARK),
		where .. ": state value " .. STATE_KEY .. " = " .. tostring(get_override(STATE_KEY)) .. ", kept as state")
	local parts = get_parts()
	check(count(parts) == #PARTS, where .. ": " .. count(parts) .. " parts, expected " .. #PARTS)
	local by_section = {}
	for path, p in pairs(parts) do
		by_section[p.section] = p
		check(p.path == path, where .. ": path field matches key " .. path)
	end
	for _, e in ipairs(PARTS) do
		local p = by_section[e.section]
		local ok = p and p.mount == e.mount and near(p.pos, e.pos)
		if ok and e.parent then
			local parent = by_section[PARTS[1].section]
			ok = parent and p.parent == parent.id
		elseif ok then
			ok = p.parent == 0
		end
		check(ok, where .. ": part " .. e.key .. (p and (" at " .. p.path) or " missing"))
	end
	local light, laser = by_section.mw_ir_light, by_section.mw_ir_laser
	check(light and laser and parts["top#" .. light.id] and parts["top#" .. laser.id], where .. ": rail parts named top#<id>")
	check(parts["scope/cover"] ~= nil, where .. ": child path scope/cover")
	local pl = parts.scope and parts.scope.placement
	check(pl and pl.bone == PLACEMENT.bone and near(pl.pos.y, 0.05) and near(pl.pos.z, 0.1) and near(pl.hpb.z, 90) and
		#pl.hides == 1 and pl.hides[1] == "wpn_scope" and parts.scope.props.offset == PLACEMENT_OFFSET,
		where .. ": scope placement " .. tostring(pl and pl.bone) .. " / " .. tostring(parts.scope and parts.scope.props.offset))
end

function verify()
	begin()
	local se = find_marked()
	if not check(se ~= nil, "marked gun found (run prepare() first)") then
		return finish("verify")
	end
	local id = se.id
	local owner = se.parent_id ~= 65535 and alife_object(se.parent_id)
	local obj = level.object_by_id(id)
	say(string.format("marked gun [%d] %s, %s, held by %s", id, se:section_name(),
		obj and "online" or "offline", owner and owner:name() or "nobody"))

	check(not string.find(se:section_name(), "_i%d+$"), "server section is the base: " .. se:section_name())
	verify_record(function(k) return se:get_override(k) end, function() return se:get_parts() end, "server",
		function(k) return se:is_state_override(k) end, function() return se:get_modifiers() end)

	local offline = se:get_override("mw_ir_offline")
	if obj then
		check(obj:section() == se:section_name(), "section() is the base: " .. obj:section())
		local inst = obj:instance_section()
		check(inst == se:section_name() .. "_i" .. id, "instance_section() is the generated section: " .. inst)
		check(near(ini_sys:r_float_ex(inst, "rpm"), RPM_FINAL),
			"generated section reads rpm = " .. RPM_FINAL .. " (override 120, modifier +25%): " .. tostring(ini_sys:r_string_ex(inst, "rpm")))
		check(ini_sys:r_float_ex(se:section_name(), "rpm") ~= RPM_FINAL, "base section keeps its own rpm")
		local e = obj:explain_stat("rpm")
		check(e.base == "120" and near(tonumber(e.final) or 0, RPM_FINAL) and e.modified,
			"explain_stat: base " .. tostring(e.base) .. ", final " .. tostring(e.final))
		verify_record(function(k) return obj:get_override(k) end, function() return obj:get_parts() end, "game",
			function(k) return obj:is_state_override(k) end, function() return obj:get_modifiers() end)
		check(not ini_sys:line_exist(inst, STATE_KEY), "the state value is not in the generated section")
		if offline then
			check(obj:get_override("mw_ir_offline") == offline, "offline edit reached the game side")
		end
	else
		say("the gun is offline: only the server copy was checked")
	end
	finish("verify")
end

function npc_give()
	local npc = level.get_target_obj and level.get_target_obj()
	if not (npc and IsStalker(npc) and npc:alive()) then
		say("aim at a living NPC first")
		return
	end
	local w = gun()
	if not w then return end
	if not w:get_override(MARK) then
		say("the gun in your hands is not marked; run prepare() first")
		return
	end
	db.actor:transfer_item(w, npc)
	say(string.format("gave the marked gun to %s. Walk away until they go offline (or change level), then verify()", npc:character_name()))
end

function offline_edit()
	begin()
	local se = find_marked()
	if not check(se ~= nil, "marked gun found") then return finish("offline_edit") end
	if level.object_by_id(se.id) then
		say("the marked gun is online; move away from it first")
		return
	end
	local stamp = tostring(math.floor(time_global() / 1000))
	check(se:set_override("mw_ir_offline", stamp), "server-side set_override while offline")
	check(se:get_override("mw_ir_offline") == stamp, "server copy holds it")
	finish("offline_edit")
	say("go back to the gun (or let it come online) and run verify()")
end

function cleanup()
	local se = find_marked()
	if not se then
		say("no marked gun")
		return
	end
	for _, p in pairs(se:get_parts()) do
		if p.parent == 0 then se:record_remove_part(p.id) end
	end
	for k in pairs(se:get_overrides()) do se:clear_override(k) end
	se:remove_modifier(MOD.source)
	say(string.format("cleared gun [%d]; record is %d bytes", se.id, se:record_size()))
end

---------------------------------------------------------------------------
-- snapshot() / compare(): every record in the game, before and after a save/load
---------------------------------------------------------------------------

local function path_of(name)
	return getFS():update_path("$app_data_root$", "") .. "mw_ir_" .. name .. ".txt"
end

local function sorted_keys(t)
	local keys = {}
	for k in pairs(t) do keys[#keys + 1] = k end
	table.sort(keys)
	return keys
end

local function describe(se, size)
	local out = { string.format("%d %s size=%d", se.id, se:section_name(), size) }
	local ovr = se:get_overrides()
	for _, k in ipairs(sorted_keys(ovr)) do
		out[#out + 1] = string.format(" o %s=%s", k, ovr[k])
	end
	local parts = se:get_parts()
	for _, path in ipairs(sorted_keys(parts)) do
		local p = parts[path]
		local props = {}
		for _, k in ipairs(sorted_keys(p.props)) do props[#props + 1] = k .. "=" .. p.props[k] end
		out[#out + 1] = string.format(" p %s id=%d parent=%d pos=%.4f sect=%s cond=%.3f paint=%s upg=%s props=%s data=%d",
			path, p.id, p.parent, p.pos, p.section, p.condition, p.paintjob,
			table.concat(p.upgrades, ","), table.concat(props, ","), p.data_size)
	end
	for _, m in ipairs(se:get_modifiers()) do
		out[#out + 1] = string.format(" m %s %s %s %.6g", m.source, m.key, m.mode, m.value)
	end
	return table.concat(out, "\n")
end

function snapshot(name)
	name = name or "a"
	local lines, n = {}, 0
	each_item(function(se, id, size)
		if size > 1 then
			lines[#lines + 1] = describe(se, size)
			n = n + 1
		end
	end)
	local f = io.open(path_of(name), "w")
	if not f then
		say("cannot write " .. path_of(name))
		return
	end
	f:write(table.concat(lines, "\n"), "\n")
	f:close()
	say(string.format("%d non-empty records written to %s", n, path_of(name)))
end

local function read_snapshot(name)
	local f = io.open(path_of(name), "r")
	if not f then return end
	local recs, cur = {}, nil
	for line in f:lines() do
		local id = line:match("^(%d+) ")
		if id then
			cur = id
			recs[cur] = line
		elseif cur then
			recs[cur] = recs[cur] .. "\n" .. line
		end
	end
	f:close()
	return recs
end

function compare(a, b)
	a, b = a or "a", b or "b"
	begin()
	local ra, rb = read_snapshot(a), read_snapshot(b)
	if not (ra and rb) then
		say("snapshot " .. (ra and b or a) .. " is missing")
		return
	end
	for id, text in pairs(ra) do
		if rb[id] ~= text then
			check(false, "record " .. id .. " changed:\n" .. text .. "\n  became\n" .. tostring(rb[id]))
		end
	end
	for id in pairs(rb) do
		if not ra[id] then check(false, "record " .. id .. " is new:\n" .. rb[id]) end
	end
	check(fails == 0, string.format("%d records in %s, %d in %s", count(ra), a, count(rb), b))
	finish("compare")
end

---------------------------------------------------------------------------
-- mods(): stacked modifiers (3d, WEAPON_ENGINE_PLAN.md 6.3) on the gun in your hands
---------------------------------------------------------------------------

local RPM_MIN, RPM_MAX = 30, 3000   -- configs\misc\stat_mods.ltx
local SM = "mw_sm_test:"
local SM_SOURCES = { "a", "b", "c", "clamp", "floor", "list", "miss", "def", "se" }

local function approx(a, b)
	return a ~= nil and b ~= nil and math.abs(a - b) <= math.max(0.001, math.abs(b) * 1e-5)
end

local function nums(s)
	local t = {}
	for x in string.gmatch(s or "", "[^,%s]+") do t[#t + 1] = tonumber(x) end
	return t
end

local function sources_of(mods, prefix)
	local t = {}
	for _, m in ipairs(mods) do
		if string.sub(m.source, 1, #prefix) == prefix then t[#t + 1] = m end
	end
	return t
end

function mods()
	local w = gun()
	if not w then return end
	begin()
	local se = alife_object(w:id())
	local function sect_val(key)
		local s = w:instance_section()
		return ini_sys:line_exist(s, key) and ini_sys:r_string_ex(s, key) or nil
	end
	for _, s in ipairs(SM_SOURCES) do w:remove_modifier(SM .. s) end

	local e0 = w:explain_stat("rpm")
	local base = tonumber(e0.base)
	if not check(base ~= nil, "explain_stat gives a numeric base rpm: " .. tostring(e0.base)) then
		return finish("mods")
	end
	local function expect(e, flat, pct)
		local p = math.max(e0.pct + pct, -0.9)
		local v = (base + e0.flat + flat) * (1 + p)
		return math.min(math.max(v, RPM_MIN), RPM_MAX)
	end

	-- Two percentages add: +10% and -5% make +5%, in either order
	check(w:add_modifier(SM .. "b", "rpm", -0.05, "pct") and w:add_modifier(SM .. "a", "rpm", 0.1, "pct"), "add two pct modifiers")
	local e = w:explain_stat("rpm")
	check(approx(e.pct - e0.pct, 0.05) and approx(tonumber(e.final), expect(e0, 0, 0.05)),
		"pct modifiers add: " .. base .. " -> " .. tostring(e.final))
	check(approx(tonumber(sect_val("rpm")), tonumber(e.final)), "the generated section holds the final value: " .. tostring(sect_val("rpm")))
	check(#sources_of(w:get_modifiers("rpm"), SM) == 2 and #sources_of(e.sources, SM) == 2, "get_modifiers and explain_stat list both")

	-- A flat and a pct: (base + flat) x (1 + pct)
	check(w:add_modifier(SM .. "c", "rpm", 50), "add a flat modifier (mode defaults to flat)")
	e = w:explain_stat("rpm")
	check(approx(tonumber(e.final), expect(e0, 50, 0.05)), "(base + 50) x 1.05 = " .. tostring(e.final))
	check(w:add_modifier(SM .. "c", "rpm", 20, "flat") and #sources_of(w:get_modifiers("rpm"), SM .. "c") == 1 and
		approx(tonumber(w:explain_stat("rpm").final), expect(e0, 20, 0.05)), "adding again with the same source and key replaces it")
	check(not w:add_modifier(SM .. "x", "rpm", 1, "bogus"), "a bad mode is refused")

	-- Several changes in a frame build the section once
	w:instance_section()
	local c0 = w:record_counters()
	w:remove_modifier(SM .. "a")
	w:remove_modifier(SM .. "b")
	w:remove_modifier(SM .. "c", "rpm")
	check(approx(tonumber(sect_val("rpm")), expect(e0, 0, 0)), "removing every source restores the value: " .. tostring(sect_val("rpm")))
	check(w:record_counters().builds - c0.builds == 1, "three removals build the section once")

	-- Clamp and pct floor
	check(w:add_modifier(SM .. "clamp", "rpm", 100000), "add a huge flat modifier")
	e = w:explain_stat("rpm")
	check(e.clamped and approx(tonumber(e.final), RPM_MAX), "clamped to the limits table: " .. tostring(e.final))
	w:remove_modifier(SM .. "clamp")
	check(w:add_modifier(SM .. "floor", "rpm", -5, "pct"), "add a -500% modifier")
	e = w:explain_stat("rpm")
	check(approx(e.pct_used, -0.9) and approx(tonumber(e.final), expect(e0, 0, -5)), "the pct floor holds it at -90%: " .. tostring(e.final))
	w:remove_modifier(SM .. "floor")

	-- A list key changes every element
	local hp = sect_val("hit_power")
	local hp0 = nums(hp)
	if #hp0 > 1 then
		check(w:add_modifier(SM .. "list", "hit_power", 0.1, "pct"), "add a pct modifier to the list key hit_power")
		local hp1 = nums(sect_val("hit_power"))
		local ok = #hp1 == #hp0
		for i = 1, #hp0 do ok = ok and approx(hp1[i], hp0[i] * 1.1) end
		check(ok, "every element changes: " .. tostring(hp) .. " -> " .. tostring(sect_val("hit_power")))
		w:remove_modifier(SM .. "list")
		check(sect_val("hit_power") == hp or approx(nums(sect_val("hit_power"))[1], hp0[1]), "and comes back")
	else
		say("hit_power is not a list on this gun; list check skipped")
	end

	-- Missing keys: skipped without a default, the limits default with one
	check(w:add_modifier(SM .. "miss", "mw_sm_nokey", 1), "add a modifier to a key the section lacks")
	e = w:explain_stat("mw_sm_nokey")
	check(not e.modified and e.error ~= nil and sect_val("mw_sm_nokey") == nil, "it is skipped: " .. tostring(e.error))
	check(w:add_modifier(SM .. "def", "mw_sm_default", 2), "add a modifier to a key with a limits default")
	e = w:explain_stat("mw_sm_default")
	check(e.base_is_default and sect_val("mw_sm_default") == "7", "default 5 + 2 = " .. tostring(sect_val("mw_sm_default")))
	w:remove_modifier(SM .. "miss")
	w:remove_modifier(SM .. "def")

	-- A part with stat_mods
	local id = w:record_add_part(0, "mw_sm_mount", "mw_sm_part_a")
	check(id > 0 and #sources_of(w:get_modifiers("rpm"), "part:" .. id) == 1, "a fitted part contributes as part:" .. id)
	check(approx(tonumber(sect_val("rpm")), expect(e0, 0, 0.1)), "part rpm +10%: " .. tostring(sect_val("rpm")))
	w:record_remove_part(id)
	check(approx(tonumber(sect_val("rpm")), expect(e0, 0, 0)), "removing the part restores it: " .. tostring(sect_val("rpm")))

	-- Through the server object
	if se then
		check(se:add_modifier(SM .. "se", "rpm", 0.2, "pct") and #sources_of(w:get_modifiers("rpm"), SM .. "se") == 1,
			"server-side add_modifier on an online item reaches the game object")
		check(#sources_of(se:get_modifiers(), SM .. "se") == 1 and approx(tonumber(se:explain_stat("rpm").final), expect(e0, 0, 0.2)),
			"server object lists and explains it")
		check(se:remove_modifier(SM .. "se") == 1, "server-side remove_modifier")
	end

	check(#sources_of(w:get_modifiers(), SM) == 0 and approx(tonumber(sect_val("rpm") or e0.final), tonumber(e0.final)), "clean up")
	finish("mods")
	say("mods: a ReloadConfig of the gun follows in the log ([reload config]) once it is idle")
end

-- Two AK-74s with the test upgrades installed in opposite orders (mod_system_mw_stat_mods_test.ltx)
local UPGRADES = { "up_firsta_ak74", "up_secona_ak74" }

local function upgrade_guns()
	local guns = {}
	db.actor:iterate_inventory(function(_, item)
		if item:section() == "wpn_ak74" then guns[#guns + 1] = item end
	end)
	table.sort(guns, function(a, b) return a:id() < b:id() end)
	return guns
end

function mods_spawn()
	for _ = 1, 2 do alife_create_item("wpn_ak74", db.actor) end
	say("two wpn_ak74 put in your backpack; run mods_upgrades()")
end

function mods_upgrades()
	begin()
	local guns = upgrade_guns()
	if not check(#guns >= 2, "two wpn_ak74 in your inventory (mods_spawn())") then return finish("mods_upgrades") end
	local finals = {}
	for i = 1, 2 do
		local w = guns[#guns - 2 + i]
		local order = i == 1 and { UPGRADES[1], UPGRADES[2] } or { UPGRADES[2], UPGRADES[1] }
		local fresh = not w:has_upgrade(UPGRADES[1]) and not w:has_upgrade(UPGRADES[2])
		for _, u in ipairs(order) do
			if not w:has_upgrade(u) then
				-- Anomaly refuses upgrades away from a mechanic unless forced, as ui_workshop does
				inventory_upgrades.force_upgrade = true
				local ok = w:install_upgrade(u)
				inventory_upgrades.force_upgrade = false
				check(ok, string.format("[%d] install %s", w:id(), u))
			end
		end
		local e = w:explain_stat("rpm")
		local ups = sources_of(e.sources, "upgrade:")
		check(#ups == 2, string.format("[%d] %d upgrade contributions", w:id(), #ups))
		local expected = tonumber(e.base) * 1.05
		check(approx(tonumber(e.final), expected), string.format("[%d] rpm %s x 1.05 = %s (%s)", w:id(), e.base, tostring(e.final),
			fresh and "installed now" or "after a reload"))
		local inst = w:instance_section()
		check(approx(ini_sys:r_float_ex(inst, "rpm"), expected), string.format("[%d] [%s] holds it", w:id(), inst))
		finals[i] = e.final
	end
	check(finals[1] == finals[2], "both install orders give the same rpm: " .. tostring(finals[1]) .. ", " .. tostring(finals[2]))
	finish("mods_upgrades")
end

-- A modifier on the worn outfit; the second run (after a save/load) checks it survived
function mods_outfit()
	begin()
	local o = db.actor:item_in_slot(7)
	if not check(o ~= nil, "wearing an outfit") then return finish("mods_outfit") end
	local had = has_mod(o:get_modifiers("burn_protection"), "mw_ir:outfit", "burn_protection", "pct", 0.1)
	if not had then
		check(o:add_modifier("mw_ir:outfit", "burn_protection", 0.1, "pct"), "add burn_protection +10% to " .. o:section())
	end
	local e = o:explain_stat("burn_protection")
	local inst = o:instance_section()
	check(e.modified and approx(ini_sys:r_float_ex(inst, "burn_protection"), tonumber(e.final)),
		string.format("[%s] burn_protection %s -> %s%s", inst, tostring(e.base), tostring(e.final), e.clamped and " (clamped)" or ""))
	finish("mods_outfit")
	say(had and "the outfit modifier survived; run_string mw_ir.mods_outfit_clear() removes it"
		or "save, load and run mods_outfit() again")
end

function mods_outfit_clear()
	local o = db.actor:item_in_slot(7)
	say(o and string.format("removed %d", o:remove_modifier("mw_ir:outfit")) or "no outfit")
end

---------------------------------------------------------------------------
-- placement(): part placement props and bind poses (4a, WEAPON_ENGINE_PLAN.md 8.1)
---------------------------------------------------------------------------

-- The Part_bench test gun, a loose mesh the Lua OGF parser can read
local OGF_MODEL = "mw\\wpn_ak74_n_one"

function placement()
	local w = gun()
	if not w then return end
	begin()
	local se = alife_object(w:id())

	-- Placement props
	w:instance_section()
	local c0 = w:record_counters()
	local id = w:record_add_part(0, "mw_pl_mount", "mw_pl_part")
	check(id > 0, "add a test part")
	check(w:set_part_prop(id, "bone", "  wpn_body ") and w:get_part_prop(id, "bone") == "wpn_body", "bone is stored trimmed")
	check(w:set_part_prop(id, "offset", "0.1,0.2, 0.3") and w:get_part_prop(id, "offset") == "0.1, 0.2, 0.3, 0, 0, 0",
		"a 3-number offset is stored with zero rotation: " .. tostring(w:get_part_prop(id, "offset")))
	check(w:set_part_prop(id, "offset", "0, 0, 0, 10, -20, 45") and w:get_part_prop(id, "offset") == "0, 0, 0, 10, -20, 45",
		"a 6-number offset is stored as given")
	check(not w:set_part_prop(id, "offset", "1, 2") and not w:set_part_prop(id, "offset", "1, 2, x"),
		"a bad offset is refused")
	check(w:get_part_prop(id, "offset") == "0, 0, 0, 10, -20, 45", "and the old one is kept")
	check(not w:set_part_prop(id, "bone", "a, b"), "two bone names are refused")
	check(w:set_part_prop(id, "hides", "wpn_scope, ,wpn_sight_front, wpn_scope") and
		w:get_part_prop(id, "hides") == "wpn_scope, wpn_sight_front", "hides drops blanks and repeats: " .. tostring(w:get_part_prop(id, "hides")))
	check(w:set_part_prop(id, "my_mod_state", "x=1;y=2") and w:get_part_prop(id, "my_mod_state") == "x=1;y=2",
		"other props are stored as given")
	check(w:set_part_prop(id, "rail_pos", 0.25) and w:get_part_prop(id, "rail_pos") == "0.25", "numbers are stored as text")

	local p
	for _, part in pairs(w:get_parts()) do
		if part.id == id then p = part end
	end
	local pl = p and p.placement
	check(pl and pl.bone == "wpn_body" and near(pl.hpb.x, 10) and near(pl.hpb.y, -20) and near(pl.hpb.z, 45) and
		#pl.hides == 2 and pl.hides[2] == "wpn_sight_front", "get_parts() gives the parsed placement")
	check(se and se:get_part_prop(id, "bone") == "wpn_body", "the server object reads the same props")
	check(se and se:set_part_prop(id, "bone", "wpn_body_2") and w:get_part_prop(id, "bone") == "wpn_body_2",
		"server-side set_part_prop on an online item reaches the game object")
	check(w:set_part_prop(id, "my_mod_state", nil) and w:get_part_prop(id, "my_mod_state") == nil and
		not w:set_part_prop(id, "my_mod_state", nil), "nil clears a prop; clearing it again returns false")
	check(not w:set_part_prop(9999, "bone", "x"), "a missing part is refused")
	w:instance_section()
	check(w:record_counters().builds == c0.builds, "placement props build no section")
	check(w:record_remove_part(id) == 1, "remove the test part")

	-- Bind poses
	local sect = w:section()
	local bones = model_bones(sect)
	local n = 0
	if bones then for _ in pairs(bones) do n = n + 1 end end
	if check(n > 0, "model_bones(" .. sect .. ") lists " .. n .. " bones") then
		local name, b = next(bones)
		local one = bone_bind_transform(sect, name)
		check(one and one.name == name and near(one.pos.x, b.pos.x) and near(one.hpb.y, b.hpb.y) and one.parent == b.parent,
			"bone_bind_transform agrees with model_bones for " .. name)
		local roots = 0
		for _, bone in pairs(bones) do
			if bone.parent == "" then roots = roots + 1 end
			if bone.parent ~= "" and not bones[bone.parent] then roots = roots + 100 end
		end
		check(roots == 1, "one root, and every parent is a bone of the model")
	end
	check(bone_bind_transform(sect, "mw_no_such_bone") == nil and model_bones("mw\\no_such_model") == nil,
		"a missing bone or model gives nil")

	-- Against Part_bench's OGF parser
	local lua_bones = mw_ir_ogf.bones(OGF_MODEL)
	local eng = model_bones(OGF_MODEL)
	if not lua_bones then
		say("meshes\\" .. OGF_MODEL .. ".ogf isn't a loose file here; the parser comparison was skipped")
	elseif check(eng ~= nil, "model_bones reads " .. OGF_MODEL) then
		check(model_bones(OGF_MODEL .. ".ogf") ~= nil and model_bones(string.gsub(OGF_MODEL, "\\", "/")) ~= nil,
			"the model path may end in .ogf and use either slash")
		local count, bad_pos, bad_rot, worst = 0, {}, {}, 0
		for name, lp in pairs(lua_bones) do
			local e = eng[name]
			count = count + 1
			if not e then
				bad_pos[#bad_pos + 1] = name .. " (missing)"
			else
				local d = math.max(math.abs(e.pos.x - lp.pos[1]), math.abs(e.pos.y - lp.pos[2]), math.abs(e.pos.z - lp.pos[3]))
				if d > 1e-4 then bad_pos[#bad_pos + 1] = string.format("%s (%.5f)", name, d) end
				local m = mw_ir_ogf.hpb_matrix(e.hpb.x, e.hpb.y, e.hpb.z)
				local r = 0
				for i = 1, 3 do for j = 1, 3 do r = math.max(r, math.abs(m[i][j] - lp.rot[i][j])) end end
				worst = math.max(worst, r)
				if r > 1e-3 then bad_rot[#bad_rot + 1] = string.format("%s (%.4f)", name, r) end
			end
		end
		check(#bad_pos == 0, string.format("bone positions match the OGF parser for %d bones%s", count,
			#bad_pos > 0 and (": " .. table.concat(bad_pos, ", ")) or ""))
		check(#bad_rot == 0, string.format("bone rotations match it through set_rotation's convention (worst %.6f)%s", worst,
			#bad_rot > 0 and (": " .. table.concat(bad_rot, ", ")) or ""))
	end
	finish("placement")
end

---------------------------------------------------------------------------
-- parts(): engine-drawn part tree (4b, WEAPON_ENGINE_PLAN.md 8.2)
---------------------------------------------------------------------------

local PT = "mw_pt_"   -- mount prefix of the test parts

local function tree_by_id(w)
	local t = {}
	for _, n in ipairs(w:get_part_tree()) do t[n.id] = n end
	return t
end

local function test_parts(w)
	local out = {}
	for _, p in pairs(w:get_parts()) do
		if string.sub(p.mount, 1, #PT) == PT then out[#out + 1] = p end
	end
	return out
end

-- An offset prop that puts a part at pos (metres) turned by hpb (degrees), both in the parent MODEL's frame,
-- when the part hangs from bone b of that model (a model_bones() entry). Offsets are in the bone's own frame,
-- which on most guns is turned against the model (the root bone often by 90 degrees), so convert:
-- offset = inverse(bone bind) * wanted.
local function offset_in_bone(b, pos, hpb)
	local O = mw_ir_ogf
	local rb = O.hpb_matrix(b.hpb.x, b.hpb.y, b.hpb.z)
	local rt = { { rb[1][1], rb[2][1], rb[3][1] }, { rb[1][2], rb[2][2], rb[3][2] }, { rb[1][3], rb[2][3], rb[3][3] } }
	local p = O.apply(rt, { pos[1] - b.pos.x, pos[2] - b.pos.y, pos[3] - b.pos.z })
	local r = O.matrix_hpb(O.mat_mul(rt, O.hpb_matrix(hpb[1], hpb[2], hpb[3])))
	return string.format("%g, %g, %g, %g, %g, %g", p[1], p[2], p[3], r[1], r[2], r[3])
end

function parts_clear()
	local w = gun()
	if not w then return end
	local n = 0
	for _, p in ipairs(test_parts(w)) do
		if p.parent == 0 then n = n + w:record_remove_part(p.id) end
	end
	say(string.format("removed %d test parts", n))
end

function parts()
	local w = gun()
	if not w then return end
	begin()
	for _, p in ipairs(test_parts(w)) do
		if p.parent == 0 then w:record_remove_part(p.id) end
	end

	local sect = w:section()
	local vis = ini_sys:r_string_ex(sect, "visual")
	local root, root_bone
	for name, b in pairs(model_bones(sect) or {}) do
		if b.parent == "" then root, root_bone = name, b end
	end
	if not check(vis and root, "the gun has a visual and a root bone: " .. tostring(vis) .. ", " .. tostring(root)) then
		return finish("parts")
	end

	local function add(parent, mount, props)
		local id = w:record_add_part(parent, mount, "mw_pt_dummy")
		for k, v in pairs(props) do w:set_part_prop(id, k, v) end
		return id
	end
	-- Two drawn parts: A on the gun's root bone, 12 cm above the gun and turned 90 degrees about the gun's up axis;
	-- B nested on A's root bone, 12 cm above A (24 cm after the move below) and lined up with A
	-- (offsets converted from the model's frame into the root bone's, see offset_in_bone)
	local a = add(0, PT .. "a", { visual = vis, bone = root, offset = offset_in_bone(root_bone, { 0, 0.12, 0 }, { 90, 0, 0 }) })
	local b = add(a, PT .. "b", { visual = vis, bone = root, offset = offset_in_bone(root_bone, { 0, 0.12, 0 }, { 0, 0, 0 }) })
	-- Parts that must not draw, each for its own reason
	local c = add(0, PT .. "c", { visual = vis })
	local d = add(0, PT .. "d", { visual = vis, bone = "mw_no_such_bone" })
	local e = add(0, PT .. "e", { visual = "mw\\no_such_model", bone = root })
	local f = add(d, PT .. "f", { visual = vis, bone = root })
	local g = add(a, PT .. "g", { visual = vis, bone = "mw_no_such_bone" })

	local t = tree_by_id(w)
	local function drawn(id, what)
		local n = t[id]
		check(n and n.drawn, what .. (n and (" " .. n.model .. " on " .. n.bone) or " missing from the tree"))
	end
	local function refused(id, what, needle)
		local n = t[id]
		check(n and not n.drawn and string.find(n.reason, needle, 1, true) ~= nil,
			what .. ": " .. tostring(n and n.reason))
	end
	drawn(a, "part A on the gun is drawn:")
	drawn(b, "part B nested on part A is drawn:")
	refused(c, "a part without placement is not drawn", "no placement")
	refused(d, "a part on a bone the gun lacks is not drawn", "bone not on the gun")
	refused(e, "a part with a missing model is not drawn", "model not found")
	refused(f, "a child of an undrawn part is not drawn", "parent part is not drawn")
	refused(g, "a nested part on a bone its parent lacks is not drawn", "bone not on the parent part")

	-- Removing parts rebuilds the tree
	for _, id in ipairs({ c, d, e }) do w:record_remove_part(id) end
	t = tree_by_id(w)
	local count = 0
	for _, p in ipairs(test_parts(w)) do if t[p.id] then count = count + 1 end end
	check(count == 3 and t[a].drawn and t[b].drawn and t[g] and not t[g].drawn and not t[f],
		"after removing the refused parts the tree has A, B and G: " .. count .. " nodes")
	w:record_remove_part(g)

	-- Moving a part rebuilds it in place
	check(w:set_part_prop(b, "offset", offset_in_bone(root_bone, { 0, 0.24, 0 }, { 0, 0, 0 })) and tree_by_id(w)[b].drawn,
		"moving part B keeps it drawn")

	-- hides (4c): a visible leaf bone of the gun, not one of the addon bones
	local bones = model_bones(sect) or {}
	local is_parent = {}
	for _, bn in pairs(bones) do is_parent[bn.parent] = true end
	local addon = { wpn_scope = true, wpn_silencer = true, wpn_launcher = true, wpn_scoped_hide = true, wpn_scoped_unhide = true }
	local leaf
	for name in pairs(bones) do
		if not is_parent[name] and not addon[name] and name ~= root and w:bone_visible(name) then leaf = name break end
	end
	if check(leaf, "the gun has a visible leaf bone to hide: " .. tostring(leaf)) then
		w:set_part_prop(a, "hides", leaf)
		t = tree_by_id(w) -- rebuilds the tree, which updates the bones
		check(t[a].hides == leaf and not w:bone_visible(leaf), "part A hides " .. leaf .. ": tree says '" .. tostring(t[a].hides) .. "'")
		w:set_part_prop(b, "hides", leaf)
		w:set_part_prop(a, "hides", nil)
		tree_by_id(w)
		check(not w:bone_visible(leaf), "with part B hiding it too, " .. leaf .. " stays hidden after A stops")
		w:set_part_prop(b, "hides", nil)
		tree_by_id(w)
		check(w:bone_visible(leaf), leaf .. " is shown again once no part hides it")
		w:set_part_prop(a, "hides", leaf)
		tree_by_id(w)
		check(not w:bone_visible(leaf), "part A hides " .. leaf .. " again, and keeps hiding it (look for the gap)")
	end

	finish("parts")
	say("two test copies of the gun now sit on top of it" .. (leaf and (", and the gun's " .. leaf .. " bone is hidden") or "")
		.. ". Check first person, third person, aiming, an NPC holding it, and save/load (then run parts_check()). "
		.. "Drop it: the dropped gun should rest on the copies, not let them sink into the ground. parts_clear() removes them.")
end

function parts_check()
	local w = gun()
	if not w then return end
	begin()
	-- Only the test parts: the marked gun from prepare() carries parts of its own
	local t = tree_by_id(w)
	local drawn, total = 0, 0
	for _, p in ipairs(test_parts(w)) do
		local n = t[p.id]
		if n then total = total + 1 end
		if n and n.drawn then drawn = drawn + 1 end
	end
	check(#test_parts(w) == 2 and drawn == 2 and total == 2, string.format("the gun has its 2 test parts drawn (%d of %d)", drawn, total))
	for _, n in ipairs(w:get_part_tree()) do
		if n.hides ~= "" then
			check(not w:bone_visible(n.hides), "part " .. n.id .. " still hides " .. n.hides)
		end
	end
	finish("parts_check")
end

-- parts_diag(): prints what the part placement works from on the gun in your hands: the root bone's bind
-- pose and its current pose in the world and first-person models, and each test part's offset and hides.
function parts_diag()
	local w = gun()
	if not w then return end
	local sect = w:section()
	local function v(x) return x and string.format("%.3f, %.3f, %.3f", x.x, x.y, x.z) or "-" end
	local function pose(p) return p and ("pos " .. v(p.pos) .. "  hpb " .. v(p.hpb)) or "missing" end
	say("gun " .. sect .. ", visual " .. tostring(ini_sys:r_string_ex(sect, "visual"))
		.. ", hud " .. tostring(ini_sys:r_string_ex(sect, "hud")))
	local bones = model_bones(sect) or {}
	local root
	for name, b in pairs(bones) do
		if b.parent == "" then
			root = name
			say("root bone " .. name .. ": bind " .. pose(b))
		end
	end
	if root then
		say("  world now: " .. pose(weapon_bone_pose(w:id(), root, false)))
		say("  hud now:   " .. pose(weapon_bone_pose(w:id(), root, true)))
	end
	for _, n in ipairs(w:get_part_tree()) do
		say(string.format("part %d (parent %d) %s on %s, offset '%s', hides '%s'%s", n.id, n.parent, n.model, n.bone,
			tostring(w:get_part_prop(n.id, "offset")), n.hides, n.drawn and "" or (": not drawn, " .. n.reason)))
		if n.hides ~= "" then
			for bone in string.gmatch(n.hides, "[^,]+") do
				say(string.format("  %s: world model visible %s; hud model %s", bone, tostring(w:bone_visible(bone)),
					weapon_bone_pose(w:id(), bone, true) and "has it" or "doesn't have it"))
			end
		end
	end
end

---------------------------------------------------------------------------
-- hooks(): the 4c script hooks (WEAPON_ENGINE_PLAN.md 8.2) on the test parts left by parts()
--   set_part_bone_visible, get_part_transform, attach_part_light / detach_part_light
---------------------------------------------------------------------------

local function has_bone(list, bone)
	return string.find("," .. (list or "") .. ",", "," .. bone .. ",", 1, true) ~= nil
end

local function dist(p, q)
	local x, y, z = p.x - q.x, p.y - q.y, p.z - q.z
	return math.sqrt(x * x + y * y + z * z)
end

function hooks()
	local w = gun()
	if not w then return end
	begin()
	local a, b
	for _, p in ipairs(test_parts(w)) do
		if p.mount == PT .. "a" then a = p.id elseif p.mount == PT .. "b" then b = p.id end
	end
	local t = tree_by_id(w)
	if not check(a and b and t[a] and t[a].drawn and t[b] and t[b].drawn, "the gun has drawn test parts A and B (run parts() first)") then
		return finish("hooks")
	end

	-- A leaf bone of the part's model to hide, and the root bones of the gun and the part
	local sect = w:section()
	local gun_root, gun_root_bone
	for name, bn in pairs(model_bones(sect) or {}) do
		if bn.parent == "" then gun_root, gun_root_bone = name, bn end
	end
	local pbones = model_bones(t[a].model) or {}
	local is_parent, part_root, leaf = {}, nil, nil
	for _, bn in pairs(pbones) do is_parent[bn.parent] = true end
	for name, bn in pairs(pbones) do
		if bn.parent == "" then part_root = name end
	end
	local addon = { wpn_scope = true, wpn_silencer = true, wpn_launcher = true }
	for name in pairs(pbones) do
		if not is_parent[name] and name ~= part_root and not addon[name] and not has_bone(t[a].hidden, name) then leaf = name break end
	end
	if not check(leaf and part_root, "part A's model has a visible leaf bone: " .. tostring(leaf)) then
		return finish("hooks")
	end
	local hud = w:get_part_transform(a, true) ~= nil
	say("the gun is in " .. (hud and "first person" or "the world view") .. "; checks below follow that")

	local function hidden_now() return has_bone(tree_by_id(w)[a].hidden, leaf) end

	-- Bone visibility
	check(w:set_part_bone_visible(a, leaf, false) and hidden_now(), "hiding " .. leaf .. " on part A in both views")
	check(w:set_part_bone_visible(a, leaf, true) and not hidden_now(), "showing it again")
	check(w:set_part_bone_visible(a, leaf, false, "world") and hidden_now() == not hud, "hidden in the world view only: " .. (hud and "visible now" or "hidden now"))
	w:set_part_bone_visible(a, leaf, true, "world")
	check(w:set_part_bone_visible(a, leaf, false, "hud") and hidden_now() == hud, "hidden in first person only: " .. (hud and "hidden now" or "visible now"))
	check(not w:set_part_bone_visible(a, leaf, false, "sideways"), "an unknown view is refused")
	check(not w:set_part_bone_visible(9999, leaf, false), "a part that doesn't exist is refused")
	w:set_part_bone_visible(a, leaf, true, "world") -- end: hidden in first person only

	-- Hooks survive a rebuild (moving part B rebuilds the tree)
	w:set_part_prop(b, "offset", offset_in_bone(gun_root_bone, { 0, 0.25, 0 }, { 0, 0, 0 }))
	tree_by_id(w)
	w:set_part_prop(b, "offset", offset_in_bone(gun_root_bone, { 0, 0.24, 0 }, { 0, 0, 0 }))
	check(hidden_now() == hud, "the hide survives a rebuild of the tree")

	-- Transforms
	local pa, pb = w:get_part_transform(a, false), w:get_part_transform(b, false)
	if check(pa and pb, "world transforms of A and B") then
		check(math.abs(dist(pa.c, pb.c) - 0.24) < 0.005, string.format("B's origin is 0.24 m from A's: %.4f", dist(pa.c, pb.c)))
		local want = dist(vector():set(0, 0.12, 0), gun_root_bone.pos)
		local got = dist(pa.c, w:bone_position(gun_root))
		check(math.abs(got - want) < 0.01, string.format("A's origin is %.3f m from the gun's root bone: %.4f", want, got))
	end
	check(w:get_part_transform(a, part_root, false) ~= nil, "a bone of the part: " .. part_root)
	check(w:get_part_transform(a, "mw_no_such_bone", false) == nil, "a bone the part lacks gives nil")
	check(w:get_part_transform(9999, false) == nil, "a part that doesn't exist gives nil")
	if hud then
		local ha = w:get_part_transform(a, true)
		check(ha ~= nil, "first-person transform of A")
	end

	-- Light
	local function make_light()
		local l = attachment_script_light()
		l.type = 2
		l.range = 15
		l.color = fcolor():set(1, 0.3, 0.2, 1)
		l.texture = "internal\\internal_light_torch_r2"
		l.shadow = false
		l.volumetric = false
		l.hud_mode = false
		l:set_direction(0, 0, 1)
		l.enabled = true
		return l
	end
	check(not w:attach_part_light(9999, make_light()), "a light for a part that doesn't exist is refused")
	check(w:attach_part_light(a, make_light(), part_root), "a light on part A")
	check(w:detach_part_light(a) and not w:detach_part_light(a), "detaching it, and detaching again finds none")
	check(w:attach_part_light(a, make_light(), part_root), "a red spotlight on part A again")
	collectgarbage("collect") -- the engine holds the only reference to the light now
	check(w:attach_part_light(a, make_light()) and w:attach_part_light(a, make_light(), part_root), "replacing the light releases the old one")
	collectgarbage("collect")

	finish("hooks")
	say("part A now has a red spotlight along its barrel, and its " .. leaf .. " bone is hidden in first person only. "
		.. "Check: the light follows the part in first and third person, aiming and walking; " .. leaf
		.. " shows in third person and is gone in first; the light stays after save/load only if a script attaches it again "
		.. "(hooks are not saved). hooks_clear() removes the light and the hide.")
end

function hooks_clear()
	local w = gun()
	if not w then return end
	for _, p in ipairs(test_parts(w)) do
		w:detach_part_light(p.id)
	end
	say("lights detached; run parts_clear() to drop the hides with the parts")
end

---------------------------------------------------------------------------
-- moves(): 4d (WEAPON_ENGINE_PLAN.md 8.1, 8.3) on the test parts left by parts():
--   the placement-only short path, and register_place_parts hooks
---------------------------------------------------------------------------

local function stats(w)
	local s = w:get_part_tree_stats()
	return s.builds, s.moves
end

local function same_matrix(m, n)
	local function close(p, q) return math.abs(p.x - q.x) < 1e-4 and math.abs(p.y - q.y) < 1e-4 and math.abs(p.z - q.z) < 1e-4 end
	return m and n and close(m.c, n.c) and close(m.i, n.i) and close(m.j, n.j) and close(m.k, n.k)
end

local hooks_added = {}

local function add_hook(f)
	local ok = register_place_parts(f)
	if ok then hooks_added[#hooks_added + 1] = f end
	return ok
end

function moves_clear()
	local n = 0
	for _, f in ipairs(hooks_added) do
		if unregister_place_parts(f) then n = n + 1 end
	end
	hooks_added = {}
	say(string.format("unregistered %d place_parts hooks", n))
end

function moves()
	local w = gun()
	if not w then return end
	begin()
	moves_clear()
	local a, b
	for _, p in ipairs(test_parts(w)) do
		if p.mount == PT .. "a" then a = p.id elseif p.mount == PT .. "b" then b = p.id end
	end
	local t = tree_by_id(w)
	if not check(a and b and t[a] and t[a].drawn and t[b] and t[b].drawn, "the gun has drawn test parts A and B (run parts() first)") then
		return finish("moves")
	end
	local gun_root_bone
	for _, bn in pairs(model_bones(w:section()) or {}) do
		if bn.parent == "" then gun_root_bone = bn end
	end
	local function up(h) return offset_in_bone(gun_root_bone, { 0, h, 0 }, { 0, 0, 0 }) end
	local function gap()
		tree_by_id(w)
		local pa, pb = w:get_part_transform(a, false), w:get_part_transform(b, false)
		return pa and pb and dist(pa.c, pb.c) or -1
	end

	-- 1. Placement-only: moving B along its "rail" moves the attachment, no rebuild
	local b0, m0 = stats(w)
	w:set_part_prop(b, "offset", up(0.30))
	local d = gap()
	local b1, m1 = stats(w)
	check(b1 == b0 and m1 == m0 + 1, string.format("moving B is an in-place move: builds %d -> %d, moves %d -> %d", b0, b1, m0, m1))
	check(math.abs(d - 0.30) < 0.001, string.format("B is 0.30 m from A after the move: %.4f", d))

	-- 2. The short path gives what a full build gives
	local fast = w:get_part_transform(b, false)
	local tmp = w:record_add_part(0, PT .. "tmp", "mw_pt_dummy") -- a new part: full build
	tree_by_id(w)
	w:record_remove_part(tmp)
	tree_by_id(w)
	local b2 = stats(w)
	check(b2 >= b1 + 2, string.format("adding and removing a part rebuilds the tree: builds %d -> %d", b1, b2))
	check(same_matrix(fast, w:get_part_transform(b, false)), "B's transform after the in-place move equals the full build's")

	-- 3. A new bone on the parent part, and hides, are in-place too; a new model is not
	local leaf
	local pb = model_bones(t[b].model) or {}
	local is_parent = {}
	for _, bn in pairs(pb) do is_parent[bn.parent] = true end
	for name, bn in pairs(pb) do
		if bn.parent ~= "" and not is_parent[name] then leaf = name break end
	end
	local _, m2 = stats(w)
	w:set_part_prop(b, "bone", leaf)
	t = tree_by_id(w)
	local _, m3 = stats(w)
	check(m3 == m2 + 1 and t[b].drawn and t[b].bone == leaf, "B onto A's bone " .. tostring(leaf) .. " is an in-place move")
	w:set_part_prop(b, "bone", t[a].bone)
	w:set_part_prop(b, "hides", leaf)
	tree_by_id(w)
	local _, m4 = stats(w)
	check(m4 == m3 + 1, "B back on the root bone, and a hides change, are in-place moves")
	local b_visual = w:get_part_prop(b, "visual") -- parts() gave B its model through this prop
	local b5 = stats(w)
	w:set_part_prop(b, "visual", t[b].model .. "") -- the same model, given as a prop: a visual change
	tree_by_id(w)
	local b6 = stats(w)
	check(b6 == b5 + 1, "a visual change rebuilds the tree")
	w:set_part_prop(b, "visual", b_visual)
	w:set_part_prop(b, "hides", nil)
	tree_by_id(w)

	-- 4. place_parts hooks
	local seen_a, seen_b, seen_offset
	local function hook1(wpn, parts)
		seen_a = 0
		local out = {}
		for _, p in pairs(parts) do
			seen_a = seen_a + 1
			if p.id == b then out[p.id] = { offset = up(0.20) } end
		end
		return out
	end
	local function hook2(wpn, parts)
		seen_b = wpn and wpn:id()
		for _, p in pairs(parts) do
			if p.id == b then seen_offset = p.props.offset end
		end
		return { [b] = { offset = up(0.22) } }
	end
	local function broken() error("mw_ir: a broken hook, on purpose") end
	local function bad() return { [b] = { offset = "not numbers" }, [9999] = { bone = "x" } } end
	check(add_hook(hook1) and not register_place_parts(hook1), "registering a hook, and again is refused")
	check(not register_place_parts(42), "registering something that isn't a function is refused")
	add_hook(broken)
	add_hook(hook2)
	add_hook(bad)
	-- any change of the parts reruns the hooks; nudge A
	local _, m5 = stats(w)
	w:set_part_prop(a, "offset", offset_in_bone(gun_root_bone, { 0, 0.121, 0 }, { 90, 0, 0 }))
	d = gap()
	local _, m6 = stats(w)
	check(seen_a and seen_a >= 2, "the hook was called with the gun's parts: " .. tostring(seen_a))
	check(seen_b == w:id(), "the hook got the weapon")
	check(seen_offset == up(0.20), "the second hook saw the first one's offset: " .. tostring(seen_offset))
	check(math.abs(d - 0.22) < 0.001, string.format("hooks run in order, the last one wins: B is %.4f m from A", d))
	check(w:get_part_prop(b, "offset") ~= nil and m6 == m5 + 1, "the result went into the record, still an in-place move")

	moves_clear()
	w:set_part_prop(b, "offset", up(0.24))
	w:set_part_prop(a, "offset", offset_in_bone(gun_root_bone, { 0, 0.12, 0 }, { 90, 0, 0 }))
	d = gap()
	check(math.abs(d - 0.24) < 0.001, "without hooks B goes back to 0.24 m")
	finish("moves")
	say("the log above should show one failed place_parts hook and two refused values per rebuild while the hooks were on.")
end

-- nudge(h): puts test part B h metres above part A (0.24 by default) and leaves it there, through the in-place path,
-- so a move can be seen. Run it a few times with different values, e.g. mw_ir.nudge(0.4), mw_ir.nudge(0.1).
function nudge(h)
	local w = gun()
	if not w then return end
	local b
	for _, p in ipairs(test_parts(w)) do
		if p.mount == PT .. "b" then b = p.id end
	end
	if not b then
		say("no test part B on the gun in your hands: run parts() first")
		return
	end
	local root_bone
	for _, bn in pairs(model_bones(w:section()) or {}) do
		if bn.parent == "" then root_bone = bn end
	end
	h = tonumber(h) or 0.24
	local _, m0 = stats(w)
	w:set_part_prop(b, "offset", offset_in_bone(root_bone, { 0, h, 0 }, { 0, 0, 0 }))
	tree_by_id(w)
	local builds, m1 = stats(w)
	say(string.format("part B is now %.2f m above part A (%s, %d builds, %d moves)", h,
		m1 > m0 and "moved in place" or "no move", builds, m1))
end

---------------------------------------------------------------------------
-- fits(): 5a fit and remove (WEAPON_ENGINE_PLAN.md 10.1) with the test items in
-- configs\mod_system_mw_parts_test.ltx: a light (mw_pt_light) that holds batteries (mw_pt_battery, data only).
-- Runs in steps, because spawned items take a moment to come online. Needs a gun in your hands.
---------------------------------------------------------------------------

local FIT = {}

-- get_parts() is keyed by part path; this gives its parts as a list
local function plist(obj)
	local out = {}
	for _, p in pairs(obj and obj:get_parts() or {}) do out[#out + 1] = p end
	return out
end

local function part_of(w, id)
	for _, p in pairs(w:get_parts()) do
		if p.id == id then return p end
	end
end

local function parts_by_section(obj, section)
	local out = {}
	for _, p in pairs(obj:get_parts()) do
		if p.section == section then out[#out + 1] = p end
	end
	return out
end

local function wait_online(ids, step, then_do)
	local tries = 0
	CreateTimeEvent("mw_ir", "fits_" .. step, 0.3, function()
		tries = tries + 1
		local all = true
		for _, id in ipairs(ids) do
			if not level.object_by_id(id) then all = false end
		end
		if all or tries > 20 then
			if not all then
				check(false, step .. ": the spawned items came online")
				finish("fits")
			else
				then_do()
			end
			return true
		end
		ResetTimeEvent("mw_ir", "fits_" .. step, 0.3)
		return false
	end)
end

local function fits_d()
	local w = level.object_by_id(FIT.gun)
	local light, bat = level.object_by_id(FIT.loose_ids[1]), level.object_by_id(FIT.loose_ids[2])
	check(light and bat and #plist(light) == 0 and #plist(bat) == 0,
		"remove_part with loose = true gave two items with nothing inside")
	local lb = light and light:section() == "mw_pt_battery" and light or bat
	check(lb and math.abs(lb:condition() - 0.4) < 0.01, "the loose battery item kept its condition: " .. tostring(lb and lb:condition()))
	check(#parts_by_section(w, "mw_pt_light") == 0 and #parts_by_section(w, "mw_pt_battery") == 0, "the gun has no test light or battery left")
	for _, id in ipairs(FIT.cleanup) do alife_release_id(id) end
	finish("fits")
	say("test items removed. Expected log lines: one refusal for fitting an item into itself, one for a missing parent.")
end

local function fits_c()
	local w = level.object_by_id(FIT.gun)
	local item = level.object_by_id(FIT.light_item)
	local bat2 = level.object_by_id(FIT.bat2_item)
	local inside = item and parts_by_section(item, "mw_pt_battery") or {}
	check(#inside == 1 and math.abs(inside[1].condition - 0.4) < 0.01,
		"the light item came off with its battery inside, condition kept: " .. tostring(#inside))
	check(bat2 and bat2:section() == "mw_pt_battery", "the second battery came off the light on the gun as its own item")
	FIT.cleanup[#FIT.cleanup + 1] = FIT.bat2_item

	-- Refit the light item: its contents and its own data (the "on" prop) go back with it
	local lid = w:fit_part(item, 0, PT .. "light", FIT.place)
	table.remove(FIT.cleanup, 1) -- the light item is fitted again, so it is gone
	local p = lid ~= 0 and part_of(w, lid)
	check(p and p.props.on == "1" and p.props.bone ~= nil, "refitting the light brings back its own data ('on' = " .. tostring(p and p.props.on) .. ")")
	local refit = parts_by_section(w, "mw_pt_battery")
	check(#refit == 1 and refit[1].parent == lid and math.abs(refit[1].condition - 0.4) < 0.01, "and its battery, still inside it")

	-- Strip it: every part comes off as its own item
	FIT.loose_ids = w:remove_part(lid, { loose = true }) or {}
	check(#FIT.loose_ids == 2, "remove_part with loose = true spawned 2 items: " .. #FIT.loose_ids)
	for _, id in ipairs(FIT.loose_ids) do FIT.cleanup[#FIT.cleanup + 1] = id end
	wait_online(FIT.loose_ids, "d", fits_d)
end

local function fits_b()
	local w = level.object_by_id(FIT.gun)
	local light = level.object_by_id(FIT.light)
	local bat1, bat2 = level.object_by_id(FIT.bat1), level.object_by_id(FIT.bat2)
	bat1:set_condition(0.4)

	-- Refusals change nothing and destroy nothing
	check(light:fit_part(light, 0, "self") == 0, "an item can't be fitted into itself")
	check(w:fit_part(bat2, 9999, "x") == 0 and level.object_by_id(FIT.bat2), "fitting onto a missing part is refused, the item stays")

	-- A battery into the loose light, in the backpack
	local b1 = light:fit_part(bat1, 0, "battery")
	check(b1 ~= 0 and #parts_by_section(light, "mw_pt_battery") == 1, "a battery goes into the loose light item")

	-- The light (with its battery) onto the gun
	local root, vis
	for name, bn in pairs(model_bones(w:section()) or {}) do
		if bn.parent == "" then root = name; FIT.root_bone = bn end
	end
	vis = ini_sys:r_string_ex(w:section(), "visual")
	FIT.place = { bone = root, visual = vis, offset = offset_in_bone(FIT.root_bone, { 0, 0.36, 0 }, { 0, 0, 0 }) }
	local lid = w:fit_part(light, 0, PT .. "light", FIT.place)
	local lp = lid ~= 0 and part_of(w, lid)
	local inside = parts_by_section(w, "mw_pt_battery")
	check(lp and lp.section == "mw_pt_light", "the light goes onto the gun: part " .. tostring(lid))
	check(#inside == 1 and inside[1].parent == lid and math.abs(inside[1].condition - 0.4) < 0.01,
		"its battery came along inside it, condition 0.4: " .. tostring(inside[1] and inside[1].condition))
	local t = tree_by_id(w)
	check(t[lid] and t[lid].drawn, "the light is drawn on the gun (0.36 m up)")
	check(inside[1] and t[inside[1].id] and not t[inside[1].id].drawn and t[inside[1].id].reason == "data only (visual = none)",
		"the battery is a data-only part: " .. tostring(inside[1] and t[inside[1].id] and t[inside[1].id].reason))

	-- A second battery into the light while it is on the gun, then out again
	local b2 = w:fit_part(bat2, lid, "battery2")
	check(b2 ~= 0 and part_of(w, b2).parent == lid, "a second battery goes into the light on the gun")
	local by_section = w:fit_part("mw_pt_battery", lid, "spare")
	check(by_section ~= 0, "fitting by section, with no item, works too")
	w:record_remove_part(by_section)
	w:set_part_prop(lid, "on", "1") -- the light's own data, which must travel with the item

	local out = w:remove_part(b2) or {}
	check(#out == 1 and #parts_by_section(w, "mw_pt_battery") == 1, "the second battery comes out; the light and the first battery stay")
	FIT.bat2_item = out[1]

	-- The light comes off, keeping its battery inside
	out = w:remove_part(lid) or {}
	check(#out == 1 and #parts_by_section(w, "mw_pt_light") == 0 and #parts_by_section(w, "mw_pt_battery") == 0,
		"the light comes off as one item; the gun has no light or battery left")
	FIT.light_item = out[1]
	FIT.cleanup = { out[1] }
	wait_online({ FIT.light_item, FIT.bat2_item or 0 }, "c", fits_c)
end

function fits()
	local w = gun()
	if not w then return end
	begin()
	if not check(ini_sys:section_exist("mw_pt_light") and ini_sys:section_exist("mw_pt_battery"),
		"the test items exist (configs/mod_system_mw_parts_test.ltx)") then
		return finish("fits")
	end
	FIT = { gun = w:id() }
	FIT.light = alife_create_item("mw_pt_light", db.actor).id
	FIT.bat1 = alife_create_item("mw_pt_battery", db.actor).id
	FIT.bat2 = alife_create_item("mw_pt_battery", db.actor).id
	wait_online({ FIT.light, FIT.bat1, FIT.bat2 }, "b", fits_b)
end

---------------------------------------------------------------------------
-- offline(): 5a fit and remove on server entities that are offline (WEAPON_ENGINE_PLAN.md 10.1). Creates a gun
-- and the test items on another level, where they stay offline, works on them and releases them. All in one go.
---------------------------------------------------------------------------

function offline()
	begin()
	if not check(ini_sys:section_exist("mw_pt_light"), "the test items exist (configs/mod_system_mw_parts_test.ltx)") then
		return finish("offline")
	end
	local gg = game_graph()
	local here = gg:vertex(db.actor:game_vertex_id()):level_id()
	local gv
	for i = 0, 20000 do
		if gg:valid_vertex_id(i) and gg:vertex(i):level_id() ~= here then gv = i break end
	end
	if not check(gv, "found a game vertex on another level") then return finish("offline") end
	local v = gg:vertex(gv)
	local function make(section)
		return alife():create(section, v:level_point(), v:level_vertex_id(), gv)
	end
	local raw_gun, raw_light, raw_bat = make("wpn_ak74"), make("mw_pt_light"), make("mw_pt_battery")
	local gun_id, light_id, bat_id = raw_gun.id, raw_light.id, raw_bat.id
	local function online(id) local o = alife():object(id) return o and o.online end
	check(online(gun_id) == false and online(light_id) == false and online(bat_id) == false, "a gun and two items, offline")

	-- A plain item comes to Lua as cse_abstract; alife_inventory_item gives it its inventory item methods
	check(type(raw_light.get_parts) ~= "function", "a plain item from alife():create has no record methods (" .. tostring(raw_light) .. ")")
	local se_gun, se_light, se_bat = alife_inventory_item(raw_gun), alife_inventory_item(light_id), alife_inventory_item(raw_bat)
	check(se_gun and se_light and se_bat and type(se_light.fit_part) == "function" and type(se_light.condition) == "number",
		"alife_inventory_item (by object or id) gives them: " .. tostring(se_light))
	check(alife_inventory_item(db.actor:id()) == nil, "alife_inventory_item of something that isn't an item is nil")
	if not (se_gun and se_light and se_bat) then
		for _, id in ipairs({ gun_id, light_id, bat_id }) do local o = alife():object(id) if o then alife():release(o, true) end end
		return finish("offline")
	end
	se_bat.condition = 0.3

	local b = se_light:fit_part(se_bat, 0, "battery")
	check(b ~= 0 and #plist(se_light) == 1 and alife():object(bat_id) == nil,
		"a battery into the offline light; the battery entity is gone")

	local lid = se_gun:fit_part(se_light, 0, "mw_pt_light", { visual = "none" })
	local light, bat
	for _, p in pairs(se_gun:get_parts()) do
		if p.section == "mw_pt_light" then light = p elseif p.section == "mw_pt_battery" then bat = p end
	end
	check(lid ~= 0 and light and bat and bat.parent == lid and math.abs(bat.condition - 0.3) < 0.01 and alife():object(light_id) == nil,
		"the light onto the offline gun, its battery inside (condition " .. tostring(bat and bat.condition) .. ")")

	local out = se_gun:remove_part(lid) or {}
	local raw_item = out[1] and alife():object(out[1])
	local item = out[1] and alife_inventory_item(out[1])
	local inside = plist(item)
	check(#out == 1 and item and #inside == 1 and inside[1].section == "mw_pt_battery" and #plist(se_gun) == 0,
		"remove_part spawns the light with its battery inside; the gun is empty")
	check(raw_item and raw_item.online == false and raw_item.parent_id == 65535 and raw_item.m_game_vertex_id == gv,
		"the light item is offline, on the ground where the gun is")

	local strip = {}
	if item then
		local g2 = se_gun:fit_part(item, 0, "mw_pt_light")
		strip = se_gun:remove_part(g2, { loose = true }) or {}
	end
	check(#strip == 2, "fitted again and stripped: 2 loose items")

	for _, id in ipairs(strip) do
		local o = alife():object(id)
		if o then alife():release(o, true) end
	end
	alife():release(alife():object(gun_id), true)
	finish("offline")
end

---------------------------------------------------------------------------
-- upgrade_keep(): 5a, a mechanic upgrade keeps the rounds and the parts. Spawns a wpn_ak74 in your inventory,
-- loads it and fits a part, installs a test upgrade (configs/mod_system_mw_stat_mods_test.ltx), checks, removes it.
---------------------------------------------------------------------------

function upgrade_keep()
	begin()
	local id = alife_create_item("wpn_ak74", db.actor).id
	local tries = 0
	CreateTimeEvent("mw_ir", "upgrade_keep", 0.3, function()
		tries = tries + 1
		local w = level.object_by_id(id)
		if not w then
			if tries > 20 then check(false, "the test AK came online") finish("upgrade_keep") return true end
			ResetTimeEvent("mw_ir", "upgrade_keep", 0.3)
			return false
		end
		w:set_ammo_elapsed(17)
		local part = w:fit_part("mw_pt_battery", 0, "mw_keep")
		check(w:get_ammo_in_magazine() == 17 and part ~= 0, "the AK holds 17 rounds and a part")
		inventory_upgrades.force_upgrade = true
		local ok = w:install_upgrade("up_firsta_ak74")
		inventory_upgrades.force_upgrade = false
		check(ok and w:has_upgrade("up_firsta_ak74"), "the upgrade is installed")
		check(w:get_ammo_in_magazine() == 17, "the rounds stay in the magazine: " .. w:get_ammo_in_magazine())
		local kept = false
		for _, p in pairs(w:get_parts()) do
			if p.id == part then kept = true end
		end
		check(kept, "the part stays fitted")
		alife_release_id(id)
		finish("upgrade_keep")
		return true
	end)
end

---------------------------------------------------------------------------
-- roles(): 5b-1 part roles (WEAPON_ENGINE_PLAN.md 9.1) on the gun in your hands, with the role test parts in
-- configs/mod_system_mw_parts_test.ltx. Checks role lists, the active sight rule and its script override, the
-- role prop, and that a vanilla scope can't be attached while sight parts are fitted. Leaves the gun as it was.
---------------------------------------------------------------------------

local ROLE_MOUNTS = { "mw_role_a", "mw_role_m", "mw_role_b", "mw_role_mz" }

local function clear_role_parts(w)
	for _, p in pairs(w:get_parts()) do
		for _, m in ipairs(ROLE_MOUNTS) do
			if p.mount == m and p.parent == 0 then w:record_remove_part(p.id) end
		end
	end
	w:set_override("active_sight", nil)
end

local function same_ids(t, ids)
	if #t ~= #ids then return false end
	for i = 1, #ids do
		if t[i] ~= ids[i] then return false end
	end
	return true
end

-- The vanilla addons the engine attaches on this gun (status 2 = attachable, none attached now), and the role part
-- that takes each over. Anomaly attaches scopes in script (item_weapon.script clones to a combo section), so on most
-- guns only the silencer and the launcher go through the engine's CanAttach.
local function vanilla_addons(w)
	local sect = w:section()
	local out = {}
	if w:weapon_silencer_status() == 2 and not w:weapon_is_silencer() then
		local name = ini_sys:r_string_ex(sect, "silencer_name")
		if name and ini_sys:section_exist(name) then
			out[#out + 1] = { kind = "silencer", item = name, part = "mw_pt_muzzle", attached = function(g) return g:weapon_is_silencer() end }
		end
	end
	if w:weapon_grenadelauncher_status() == 2 and not w:weapon_is_grenadelauncher() then
		local name = ini_sys:r_string_ex(sect, "grenade_launcher_name")
		if name and ini_sys:section_exist(name) then
			out[#out + 1] = { kind = "launcher", item = name, part = "mw_pt_launcher", attached = function(g) return g:weapon_is_grenadelauncher() end }
		end
	end
	if w:weapon_scope_status() == 2 and not w:weapon_is_scope() then
		local list = ini_sys:r_string_ex(sect, "scopes")
		local first = list and string.match(list, "([^,%s]+)")
		local name = first and first ~= "none" and (ini_sys:r_string_ex(first, "scope_name") or first)
		if name and ini_sys:section_exist(name) then
			out[#out + 1] = { kind = "scope", item = name, part = "mw_pt_sight", attached = function(g) return g:weapon_is_scope() end }
		end
	end
	return out
end

local function addon_status(w)
	return string.format("%s: scope status %s (attached %s), silencer status %s (attached %s), launcher status %s (attached %s)",
		w:section(), tostring(w:weapon_scope_status()), tostring(w:weapon_is_scope()),
		tostring(w:weapon_silencer_status()), tostring(w:weapon_is_silencer()),
		tostring(w:weapon_grenadelauncher_status()), tostring(w:weapon_is_grenadelauncher()))
end

-- The exclusivity check: on gun_id (the gun in your hands, or a test AK spawned for it, released afterwards)
local function roles_scope(gun_id, spawned)
	local tries = 0
	local item_id, addon
	local function done()
		if spawned then alife_release_id(gun_id) end
		finish("roles")
		return true
	end
	CreateTimeEvent("mw_ir", "roles_scope", 0.3, function()
		tries = tries + 1
		local w = level.object_by_id(gun_id)
		if w and not item_id then
			addon = vanilla_addons(w)[1]
			if not addon then
				say("no vanilla addon this gun's engine attaches is free: the exclusivity check is skipped. " .. addon_status(w))
				return done()
			end
			item_id = alife_create_item(addon.item, db.actor).id
		end
		local item = item_id and level.object_by_id(item_id)
		if not (w and item) then
			if tries > 20 then check(false, "the test gun and the vanilla addon came online") return done() end
			ResetTimeEvent("mw_ir", "roles_scope", 0.3)
			return false
		end
		-- With a part of that role fitted, the vanilla addon is refused
		local p = w:fit_part(addon.part, 0, "mw_role_a")
		w:weapon_addon_attach(item)
		check(not addon.attached(w) and level.object_by_id(item_id) ~= nil,
			"with a " .. addon.kind .. " part fitted, the vanilla " .. addon.kind .. " [" .. addon.item .. "] is refused and stays in the inventory")
		-- Without it, the vanilla addon attaches as always (grandfathering)
		w:record_remove_part(p)
		w:weapon_addon_attach(item)
		check(addon.attached(w), "without the part, the vanilla " .. addon.kind .. " attaches as before")
		w:weapon_addon_detach(addon.item, true)
		check(not addon.attached(w), "and detaches as before")
		-- The detached item is spawned a moment later; release it once it has a server object
		CreateTimeEvent("mw_ir", "roles_addon_cleanup", 0.5, function()
			local back = db.actor:object(addon.item)
			if back and alife():object(back:id()) then alife_release_id(back:id()) end
			return true
		end)
		return done()
	end)
end

function roles()
	local w = gun()
	if not w then return end
	begin()
	if not check(ini_sys:section_exist("mw_pt_sight"), "the role test parts exist (configs/mod_system_mw_parts_test.ltx)") then
		return finish("roles")
	end
	clear_role_parts(w)
	local before = w:get_roles()
	check(#before.sight == 0 and #before.muzzle == 0 and before.active_sight == 0, "no role parts at the start")

	-- A sight on the gun, and a sight-with-laser one mount deeper
	local a = w:fit_part("mw_pt_sight", 0, "mw_role_a")
	local m = w:fit_part("mw_pt_light", 0, "mw_role_m")
	local b = w:fit_part("mw_pt_sight_laser", m, "mw_role_b")
	local mz = w:fit_part("mw_pt_muzzle", 0, "mw_role_mz")
	local r = w:get_roles()
	check(same_ids(r.sight, { a, b }) and same_ids(r.muzzle, { mz }) and #r.launcher == 0,
		"role lists: sight {" .. table.concat(r.sight, ", ") .. "}, muzzle {" .. table.concat(r.muzzle, ", ") .. "}")
	local lr = w:get_part_roles(b)
	check(#lr == 2 and lr[1] == "sight" and lr[2] == "laser", "a section's untidy role list reads as 'sight, laser': " .. table.concat(lr, ", "))
	check(w:has_part_role("laser") and not w:has_part_role("launcher"), "has_part_role")

	-- The active sight: the shallowest by default, the script's choice when it names a fitted sight
	check(r.active_sight == a, "the shallowest sight is active by default: " .. tostring(r.active_sight))
	w:set_override("active_sight", tostring(b), false)
	check(w:get_roles().active_sight == b, "active_sight set by script picks the deeper sight")
	w:set_override("active_sight", "9999", false)
	check(w:get_roles().active_sight == a, "an active_sight that isn't a fitted sight falls back to the default")
	w:set_override("active_sight", nil)

	-- The role prop replaces the section's roles
	check(w:set_part_prop(a, "role", " Muzzle , muzzle ") and w:get_part_prop(a, "role") == "muzzle", "the role prop is normalised: '" .. tostring(w:get_part_prop(a, "role")) .. "'")
	r = w:get_roles()
	check(same_ids(r.sight, { b }) and same_ids(r.muzzle, { a, mz }) and r.active_sight == b, "the role prop moves part A from sight to muzzle")

	clear_role_parts(w)
	r = w:get_roles()
	check(#r.sight == 0 and #r.muzzle == 0, "the role test parts are gone again")

	if vanilla_addons(w)[1] then
		roles_scope(w:id(), false)
	else
		say("the gun in your hands has no free vanilla addon the engine attaches; a test wpn_ak74 is spawned for the exclusivity check")
		roles_scope(alife_create_item("wpn_ak74", db.actor).id, true)
	end
end

---------------------------------------------------------------------------
-- sights(): 5b-2 sight parts (WEAPON_ENGINE_PLAN.md 9.1) on the gun in your hands, with mw_pt_sight_4x and
-- mw_pt_sight_ref (sight_section = wpn_addon_scope) from configs/mod_system_mw_parts_test.ltx. The active
-- sight's scope keys go into the gun's generated section with scope_status = 1, the gun reloads its config
-- and reads them as a built-in scope; a script's active_sight switches sights; without sights the gun is as
-- before. Leaves the gun as it was.
---------------------------------------------------------------------------

local SIGHT_MOUNTS = { "mw_sight_a", "mw_sight_b" }

local function clear_sight_parts(w)
	for _, p in pairs(w:get_parts()) do
		for _, m in ipairs(SIGHT_MOUNTS) do
			if p.mount == m and p.parent == 0 then w:record_remove_part(p.id) end
		end
	end
	w:set_override("active_sight", nil)
end

local function scope_factor(w)
	local c = w:cast_Weapon()
	return c and c:GetScopeZoomFactor()
end

-- Runs then_do(w) once cond(w) holds (the config reload waits until the gun is idle and not aimed)
local function wait_for(name, gun_id, cond, what, then_do)
	local tries = 0
	CreateTimeEvent("mw_ir", name, 0.2, function()
		tries = tries + 1
		local w = level.object_by_id(gun_id)
		if w and cond(w) then
			then_do(w)
			return true
		end
		if not w or tries > 50 then
			check(false, what .. " (timed out: keep the gun idle and don't aim)")
			if w then clear_sight_parts(w) end
			finish("sights")
			return true
		end
		ResetTimeEvent("mw_ir", name, 0.2)
		return false
	end)
end

function sights()
	local w = gun()
	if not w then return end
	begin()
	if not check(ini_sys:section_exist("mw_pt_sight_4x") and ini_sys:section_exist("wpn_addon_scope"),
		"the sight test parts and wpn_addon_scope exist") then
		return finish("sights")
	end
	if w:weapon_scope_status() == 2 and w:weapon_is_scope() then
		say("take the vanilla scope off this gun first: with a sight part fitted the parts win and the scope would come off")
		return finish("sights")
	end
	clear_sight_parts(w)
	local id = w:id()
	local base_status = w:weapon_scope_status()
	local base_factor = scope_factor(w)
	local ref_factor = ini_sys:r_float_ex("wpn_addon_scope", "scope_zoom_factor")
	say(string.format("%s: scope status %s, scope zoom factor %s", w:section(), tostring(base_status), tostring(base_factor)))

	-- A 4x sight: its keys are in the generated section, the base section is untouched
	local a = w:fit_part("mw_pt_sight_4x", 0, "mw_sight_a")
	local inst = w:instance_section()
	check(inst ~= w:section() and ini_sys:r_float_ex(inst, "scope_status") == 1 and ini_sys:r_float_ex(inst, "scope_zoom_factor") == 4
		and ini_sys:r_string_ex(inst, "scope_texture") == "none",
		"[" .. tostring(inst) .. "] has the sight's keys and scope_status = 1")
	check(ini_sys:r_float_ex(w:section(), "scope_status") == base_status, "the base section keeps its scope_status")
	check(ini_sys:r_string_ex(inst, "role") == nil, "only scope keys are copied, not the part's role")

	wait_for("sights_a", id, function(g) return g:weapon_scope_status() == 1 and scope_factor(g) ~= base_factor end,
		"the gun reloads with the sight as a built-in scope", function(g)
		local f4 = scope_factor(g)
		check(g:weapon_is_scope(), "weapon_is_scope() with the sight part: " .. tostring(g:weapon_is_scope()))
		check(true, "scope zoom factor with the 4x sight: " .. tostring(f4))

		-- A second sight next to it: the first stays active until a script picks the second
		local b = g:fit_part("mw_pt_sight_ref", 0, "mw_sight_b")
		check(g:get_roles().active_sight == a and ini_sys:r_float_ex(g:instance_section(), "scope_zoom_factor") == 4,
			"a second sight in record order leaves the first active")
		g:set_override("active_sight", tostring(b), false)
		inst = g:instance_section()
		check(g:get_roles().active_sight == b and ini_sys:r_float_ex(inst, "scope_zoom_factor") == ref_factor
			and ini_sys:r_string_ex(inst, "scope_texture") == ini_sys:r_string_ex("wpn_addon_scope", "scope_texture"),
			"active_sight switches the section to wpn_addon_scope's data (sight_section): factor " .. tostring(ref_factor))

		wait_for("sights_b", id, function(g2) return math.abs(scope_factor(g2) - f4) > 0.0001 end,
			"the gun reloads with the switched sight", function(g2)
			local fr = scope_factor(g2)
			check(math.abs(fr / f4 - ref_factor / 4) < 0.01,
				string.format("the zoom factors follow the sights: %s / %s = %s / 4", tostring(fr), tostring(f4), tostring(ref_factor)))

			-- Without sights the gun is as before
			clear_sight_parts(g2)
			check(ini_sys:r_float_ex(g2:instance_section(), "scope_status") == base_status, "without sights the section's scope_status is the base one again")
			wait_for("sights_c", id, function(g3) return g3:weapon_scope_status() == base_status and scope_factor(g3) == base_factor end,
				"the gun reloads to its own scope status " .. tostring(base_status) .. " and factor " .. tostring(base_factor), function(g3)
				check(true, "the gun is back to its own scope status and zoom factor")
				finish("sights")
			end)
		end)
	end)
end
